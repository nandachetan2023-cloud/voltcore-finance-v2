# Copy to .env and fill in real values. Never commit .env.

# Target database: PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voltcore_erp?schema=public"

# SaaS fallback tenant used when no session tenant is present (see src/lib/tenant.ts)
DEFAULT_TENANT_ID="demo-erp"

# next-auth (see src/lib/tenant.ts)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# Seeded development admin account created by scripts/seed-admin-user.ts
ADMIN_EMAIL="admin@voltcore.in"
ADMIN_PASSWORD="replace-with-the-generated-admin-password"

# Seeded finance admin account created by scripts/seed-finance-admin-user.ts
FINANCE_ADMIN_EMAIL="finance_admin@voltcore.in"
FINANCE_ADMIN_PASSWORD="replace-with-the-generated-finance-admin-password"

# Public base URL used for tenant subdomain resolution
NEXT_PUBLIC_APP_URL="http://localhost:3000"