// ── Finance – Alerts / Notifications ────────────────────────────────
model FinAlert {
  id        Int      @id @default(autoincrement())
  type      String   @default("Overdue")
  title     String
  message   String
  invoiceId Int?
  siteId    Int?
  poId      Int?
  amount    Float    @default(0)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  invoice FinInvoice? @relation(fields: [invoiceId], references: [id])
  site    FinSite?    @relation(fields: [siteId], references: [id])

  @@index([isRead])
  @@index([type])
  @@map("FinAlert")
}

// ── Finance – Chart of Accounts ──────────────────────────────────────
model FinAccount {
  id            Int      @id @default(autoincrement())
  accountCode   String   @unique
  name          String
  group         String   @default("Assets") // Assets | Liabilities | Capital | Income | Expenses | Direct Income | Direct Expenses | Indirect Income | Indirect Expenses
  type          String   @default("Asset") // Asset | Liability | Equity | Income | Expense
  parentId      Int? // self-relation for hierarchy
  sortOrder     Int      @default(0) // index within parent for drag-drop reorder
  taxApplicable Boolean  @default(false)
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent       FinAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     FinAccount[]     @relation("AccountHierarchy")
  journalLines FinJournalLine[]
  budgetLines  FinBudgetLine[]

  @@index([type])
  @@index([parentId])
  @@index([group])
  @@map("FinAccount")
}

// ── Finance – Journal Entry ──────────────────────────────────────────
model FinJournalEntry {
  id              Int       @id @default(autoincrement())
  entryNo         String    @unique
  entryDate       DateTime  @db.Date
  reference       String?
  description     String?
  siteId          Int
  jobCode         String? // job wise costing
  poNo            String? // purchase order reference
  costCenter      String? // cost center reference
  department      String? // department wise costing
  projectManager  String? // accountability
  voucherType     String? // Journal | Payment | Receipt | Contra
  status          String    @default("Draft") // Draft | Pending | Posted | Rejected | Reversed
  submittedBy     String?
  submittedAt     DateTime?
  postedAt        DateTime?
  postedBy        String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  attachmentPath  String? // supporting document, base64 data URL (same pattern as company logo upload)
  totalDebit      Float     @default(0)
  totalCredit     Float     @default(0)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  site      FinSite          @relation(fields: [finSiteId], references: [id])
  lines     FinJournalLine[]
  approvals FinApprovalLog[]
  finSiteId Int

  @@index([siteId])
  @@index([entryDate])
  @@index([status])
  @@map("FinJournalEntry")
}

// ── Finance – Journal Entry Lines (debit/credit) ─────────────────────
model FinJournalLine {
  id             Int      @id @default(autoincrement())
  entryId        Int
  accountId      Int
  description    String?
  debit          Float    @default(0)
  credit         Float    @default(0)
  costCenter     String? // optional cost center reference
  jobCode        String? // job wise costing
  siteCode       String? // site wise costing (mirrors parent entry's site by default)
  department     String? // department wise costing
  projectManager String? // accountability
  createdAt      DateTime @default(now())

  entry   FinJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account FinAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("FinJournalLine")
}

// ── Finance – Budget Plan ────────────────────────────────────────────
model FinBudget {
  id          Int      @id @default(autoincrement())
  fiscalYear  String // e.g. "2025-26"
  name        String
  siteId      Int
  version     String // e.g. "1.0" or "1.1"
  status      String   @default("Draft") // Draft | Approved
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site      FinSite         @relation(fields: [finSiteId], references: [id])
  lines     FinBudgetLine[]
  finSiteId Int

  @@unique([siteId, fiscalYear, version])
  @@index([fiscalYear])
  @@index([siteId])
  @@map("FinBudget")
}

// ── Finance – Budget Lines (12-month grid) ────────────────────────
model FinBudgetLine {
  id        Int      @id @default(autoincrement())
  budgetId  Int
  accountId Int
