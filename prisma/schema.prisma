model FinPayment {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  amount         Float    @default(0)
  paymentDate    DateTime @db.Date
  paymentMode    String   @default("Bank Transfer")
  bankAccountId  Int?
  voucherNo      String?
  referenceNo    String?
  siteCode       String? // site wise costing
  jobCode        String? // job wise costing
  poNo           String? // purchase order reference
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  status         String   @default("Received")
  remarks        String?
  createdAt      DateTime @default(now())

  invoice     FinInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("FinPayment")
}

// ── Finance: Receipt Entry (money received against customer invoices) ────────
model FinReceipt {
  id          Int       @id @default(autoincrement())
  receiptNo   String    @unique
  receiptDate DateTime  @db.Date
  partyName   String
  invoiceRef  String?
  amount      Float     @default(0)
  mode        String    @default("NEFT") // NEFT | IMPS | RTGS | Cheque | UPI | Cash
  bankRef     String?
  jobCode     String? // job wise costing
  siteCode    String? // site wise costing
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([receiptDate])
  @@index([partyName])
  @@map("FinReceipt")
}

// ── Inventory: Material Receipt / Goods Receipt Note (GRN) ──────────────────
model FinMaterialReceipt {
  id            Int       @id @default(autoincrement())
  grnNo         String    @unique
  grnDate       DateTime  @db.Date
  poRef         String?
  itemName      String
  vendorName    String?
  qtyReceived   Float     @default(0)
  qtyPO         Float     @default(0)
  unit          String    @default("nos")
  rate          Float     @default(0)
  value         Float     @default(0)
  siteCode      String?
  jobCode       String?
  status        String    @default("Received") // Received | Posted | Rejected
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([grnDate])
  @@index([poRef])
  @@map("FinMaterialReceipt")
}

// ── Procurement: Vendor directory ─────────────────────────────────
model FinVendor {
  id            Int      @id @default(autoincrement())
  name          String
  categories    Json     @default("[]") // ["Electrical","Mechanical",...]
  region        String
  status        String   @default("standard") // preferred | standard | blacklisted
  rating        Float    @default(3.0)
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  certificates  Json     @default("[]") // [{name,certNo,issueDate,expiryDate}]
  metrics       Json     @default("{}") // {onTimeDelivery,qualityRating,priceCompetitiveness}
  blacklistLog  Json     @default("[]") // [{date,reason,setBy}]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("FinVendor")
}

// ── Procurement: Purchase Order register (simplified ledger view) ──
model FinPO {
  id                 Int       @id @default(autoincrement())
  poNo               String    @unique
  vendor             String
  project            String
  projectShort       String
  totalValue         Float     @default(0)
  deliveryAddress    String
  requiredDate       DateTime  @db.Date
  actualDeliveryDate DateTime? @db.Date
  lineItems          Json      @default("[]") // [{id,itemDesc,qtyOrdered,qtyReceived,unit,unitPrice,total}]
  status             String    @default("Open") // Open | Partially Received | Completed | Overdue
  poIssueDate        DateTime  @db.Date
  grnDate            DateTime? @db.Date
  invoiceMatchDate   DateTime? @db.Date
  poIssued           Boolean   @default(true)
  grnCompleted       Boolean   @default(false)
  invoiceMatched     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([poNo])
  @@index([status])
  @@map("FinPO")
}

model FinImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  fileHash    String   @default("")
  importedBy  String   @default("")
  importedAt  DateTime @default(now())
  status      String   @default("completed") // preview|completed|failed
  summaryJson Json?

  rows   FinImportRow[]
  errors FinImportRowError[]

  @@index([importedAt])
  @@map("FinImportBatch")
}

model FinImportRow {
  id        String   @id @default(cuid())
  batchId   String
  sheetName String   @default("")
  rowNumber Int      @default(0)
  raw       Json
  createdAt DateTime @default(now())

  batch  FinImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  errors FinImportRowError[]

  @@index([batchId])
  @@index([sheetName])
  @@map("FinImportRow")
}

model FinImportRowError {
  id        String   @id @default(cuid())
  batchId   String
  rowId     String?
  sheetName String   @default("")
  rowNumber Int      @default(0)
  column    String   @default("")
  message   String
  severity  String   @default("error") // error|warning
  createdAt DateTime @default(now())

  batch FinImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  row   FinImportRow?  @relation(fields: [rowId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([severity])
  @@map("FinImportRowError")
}

model FinFollowUp {
  id              Int       @id @default(autoincrement())
  invoiceId       Int
  clientName      String?
  invoiceNo       String?
  balanceAmount   Float     @default(0)
  contactNo       String?
  contactPerson   String?
  matterDiscussed String?
  followUpDate    DateTime  @db.Date
  callBackDate    DateTime? @db.Date
  mode            String    @default("Call")
  remarks         String?
  nextFollowUp    DateTime? @db.Date
  status          String    @default("Pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice FinInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([nextFollowUp])
  @@index([status])
  @@map("FinFollowUp")
}

// ── Finance – Site Expense Claims ───────────────────────────────────
model FinExpenseClaim {
  id             Int       @id @default(autoincrement())
  claimNo        String    @unique
  siteId         Int
  poId           Int?
  jobCode        String? // job wise costing
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  siteType       String    @default("Site") // Site | HO
  expenseType    String    @default("") // GAP FOODING | Advance | ABF | etc.
  submittedBy    String
  date           DateTime  @db.Date
  receivedAmount Float     @default(0) // Cash received from HO
  totalAmount    Float     @default(0) // Incurred / spent
  gstAmount      Float     @default(0)
  tdsAmount      Float     @default(0)
  billNo         String?
  approvalStatus String    @default("Draft") // Draft | Pending | Approved | Rejected | Paid
  status         String    @default("Draft")
  remarks        String?
  postedAt       DateTime?
  approvedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site        FinSite           @relation(fields: [siteId], references: [id])
  po          FinPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  items       FinExpenseItem[]
  approvals   FinApprovalLog[]
  pettyCashes FinPettyCash[]

  @@index([claimNo])
  @@index([siteId])
  @@index([status])
  @@map("FinExpenseClaim")
}

model FinExpenseItem {
  id          Int       @id @default(autoincrement())
  claimId     Int
  itemDate    DateTime? @db.Date
  category    String    @default("")
  name        String?
  description String?
  amount      Float     @default(0)
  remark      String?
  receiptUrl  String?
  createdAt   DateTime  @default(now())

  claim FinExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("FinExpenseItem")
}

// ── Finance – Petty Cash (HO) ───────────────────────────────────────
model FinPettyCash {
  id                 Int       @id @default(autoincrement())
  voucherNo          String    @unique
  date               DateTime  @db.Date
  description        String
  amount             Float
  type               String    @default("Debit")
  category           String?
  partyId            Int?
  siteId             Int?
  poId               Int?
  jobCode            String? // job wise costing
  costCenter         String? // cost center reference
  department         String? // department wise costing
  projectManager     String? // accountability
  expenseClaimId     Int?
  linkedType         String    @default("Direct")
  authorizedBy       String?
  custodian          String? // person holding this petty cash float (Site Incharge / Store Incharge / Admin Executive)
  limitAmount        Float? // the custodian's sanctioned petty cash limit
  paymentMode        String?
  balance            Float     @default(0)
  referenceNo        String?
  remarks            String?
  billAttachmentPath String?
  approvalStatus     String    @default("Draft") // Draft | Pending | Approved | Rejected
  submittedBy        String?
  submittedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  party        FinParty?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  site         FinSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  po           FinPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  expenseClaim FinExpenseClaim?  @relation(fields: [expenseClaimId], references: [id], onDelete: SetNull)
  approvals    FinApprovalLog[]

  @@index([voucherNo])
  @@index([date])
  @@index([type])
  @@index([poId])
  @@index([expenseClaimId])
  @@index([approvalStatus])
  @@map("FinPettyCash")
}

// ── Finance – Payment Advice ────────────────────────────────────────
model FinPaymentAdvice {
  id             Int       @id @default(autoincrement())
  adviceNo       String    @unique
  partyId        Int?
  siteId         Int?
  poId           Int?
  jobCode        String? // job wise costing
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  totalAmount    Float
  paymentDate    DateTime  @db.Date
  paymentMode    String    @default("Bank Transfer")
  referenceNo    String?
  bankName       String?
  accountNo      String?
  ifscCode       String?
  supplierName   String?
  vendorCode     String?
  panNo          String?
  bankAccountId  Int?
  status         String    @default("Draft")
  postedBy       String?
  approvedBy     String?
  notes          String?
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  party       FinParty?              @relation(fields: [partyId], references: [id])
  site        FinSite?               @relation(fields: [siteId], references: [id])
  po          FinPurchaseOrder?      @relation(fields: [poId], references: [id])
  bankAccount BankAccount?           @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  lines       FinPaymentAdviceLine[]
  approvals   FinApprovalLog[]

  @@index([adviceNo])
  @@index([partyId])
  @@map("FinPaymentAdvice")
}

model FinPaymentAdviceLine {
  id            Int      @id @default(autoincrement())
  adviceId      Int
  invoiceId     Int? // Link to FinInvoice
  billNo        String? // If invoice not yet imported
  invDate       String? // Invoice date
  month         String? // e.g. "December Month"
  invAmount     Float? // Total rent / gross invoice amount (before TDS/GST)
  gst           Float? // GST amount
  tdsAmount     Float? // TDS deducted
  paidAmount    Float? // Paid amount
  balanceAmount Float? // Balance amount
  amount        Float
  remarks       String?
  voucherNo     String? // Voucher number
  createdAt     DateTime @default(now())

  advice  FinPaymentAdvice @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  invoice FinInvoice?      @relation(fields: [invoiceId], references: [id])

  @@index([adviceId])
  @@index([invoiceId])
  @@map("FinPaymentAdviceLine")
}

// ── Finance – Purchase Order ────────────────────────────────────────
model FinPurchaseOrder {
  id                      Int       @id @default(autoincrement())
  poNo                    String    @unique
  revisionNo              Int       @default(1)
  originalPoId            Int?
  vendorId                String
  vendorName              String
  vendorAddress           String?
  siteId                  Int
  jobCode                 String? // job wise costing
  costCenter              String? // cost center reference
  department              String? // department wise costing
  projectManager          String? // accountability
  date                    DateTime  @db.Date
  descriptionOfWork       String?
  orderInitiationDate     DateTime? @db.Date
  orderCompletionDate     DateTime? @db.Date
  orderBidPercent         String?
  bgAmount                Float     @default(0)
  bgSource                String?
  totalAmount             Float     @default(0)
  unexecutedWorkAmount    Float     @default(0)
  amountBookedLastFY      Float     @default(0)
  amountBookedCurrentFY   Float     @default(0)
  amountToBeBookedByEndFY Float     @default(0)
  billRaisedAmount        Float     @default(0)
  amountReceivedOutOfBill Float     @default(0)
  workDoneNotBilled       Float     @default(0)
  delayExtensionLetter    String?
  reasonOfDelay           String?
  subcontractedTo         String?
  billTo                  String?
  termsConditions         String?
  subtotal                Float     @default(0)
  taxAmount               Float     @default(0)
  status                  String    @default("Draft")
  grnDate                 DateTime? @db.Date
  grnRef                  String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  site             FinSite             @relation(fields: [siteId], references: [id])
  originalPo       FinPurchaseOrder?   @relation("PORevision", fields: [originalPoId], references: [id])
  revisions        FinPurchaseOrder[]  @relation("PORevision")
  items            FinPOItem[]
  invoices         FinInvoice[]
  paymentAdvices   FinPaymentAdvice[]
  pettyCashes      FinPettyCash[]
  expenseClaims    FinExpenseClaim[]
  clientFollowUps  FinClientFollowUp[]
  accountsPayables AccountsPayable[]
  jobs             FinJob[]
  storeGrns        FinStoreGrn[]

  @@index([poNo])
  @@index([siteId])
  @@index([status])
  @@map("FinPurchaseOrder")
}

// ── Finance – Project (contract level) ───────────────────────────────
// A project is the top-level client contract. One project can hold many
// jobs/sites, and each job can hold sub-jobs (phases). Drives roll-up
// reporting from sub-job → job → project.
model FinProject {
  id              Int      @id @default(autoincrement())
  projectCode     String   @unique // e.g. DEL-METRO-01
  name            String
  client          String
  contractValue   Float    @default(0)
  sector          String? // Power | Mining | Industrial — also doubles as the "Type" shown on the All Projects list (Thermal/Solar/Transmission/Substation/Maintenance)
  projectManager  String?
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  status          String   @default("Active") // Active | On Hold | Completed | Cancelled — the All Projects list uses its own vocabulary (On Track/At Risk/Delayed/Near Done/Completed), stored as-is
  description     String?
  site            String? // free-text site/location shown on the All Projects list (not an FK — a project can span multiple FinSite rows via its jobs)
  progress        Int      @default(0) // 0-100, manually tracked on the All Projects list
  people          Int      @default(0) // headcount, manually tracked on the All Projects list
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs FinJob[]

  @@index([projectCode])
  @@index([status])
  @@map("FinProject")
}

// ── Finance – Job Master (one unique job code per PO/project) ────────
// Hierarchy: project (FinProject) → job → sub-job (parentId).
// siteId points to the physical site the job executes at.
model FinJob {
  id          Int      @id @default(autoincrement())
  jobCode     String   @unique // e.g. JOB-2026-001
  projectId   Int? // the parent contract-level project
  parentId    Int? // set when this is a sub-job / phase of another job
  poId        Int?
  siteId      Int
  description String?
  budget      Float    @default(0) // job-specific budget (from project budget)
  status      String   @default("Active") // Active | Completed | On Hold | Closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  po        FinPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  site      FinSite           @relation(fields: [siteId], references: [id])
  project   FinProject?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    FinJob?           @relation("FinJobHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  FinJob[]          @relation("FinJobHierarchy")
  storeGrns            FinStoreGrn[]
  materialRequisitions FinMaterialRequisition[]
  storeIssues          FinStoreIssue[]
  materialReturns      FinMaterialReturn[]
  scrapEntries         FinScrapEntry[]

  @@index([projectId])
  @@index([parentId])
  @@index([poId])
  @@index([siteId])
  @@index([status])
  @@map("FinJob")
}

model FinPOItem {
  id            Int    @id @default(autoincrement())
  poId          Int
  description   String
  unitOfMeasure String @default("Nos")
  quantity      Float
  unitRate      Float
  taxPercent    Float  @default(0)
  total         Float  @default(0)
  receivedQty   Float  @default(0)

  po FinPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnLines FinStoreGrnLine[]

  @@index([poId])
  @@map("FinPOItem")
}

// ── Finance – Credit Notes ──────────────────────────────────────────
model FinCreditNote {
  id                         Int       @id @default(autoincrement())
  creditNoteNo               String    @unique
  trackingNo                 String?
  poNo                       String?
  invoiceId                  Int
  siteId                     Int
  jobCode                    String? // job wise costing
  costCenter                 String? // cost center reference
  department                 String? // department wise costing
  projectManager             String? // accountability
  creditNoteAgainstInvoiceNo String?
  client                     String?
  area                       String?
  monthWork                  String?
  date                       DateTime  @db.Date
  invoiceValue               Float     @default(0)
  gstValue                   Float     @default(0)
  totalInvoiceValue          Float     @default(0)
  amount                     Float     @default(0)
  afterTdsBalance            Float     @default(0)
  receivedAmount             Float     @default(0)
  receivedDate               DateTime? @db.Date
  voucherNo                  String?
  debitAmount                Float     @default(0)
  holdAmount                 Float     @default(0)
  reason                     String?
  remarks                    String?
  paymentDueDate             DateTime? @db.Date
  status                     String    @default("Issued")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

