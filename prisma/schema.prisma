  section   String? // e.g. TDS section
  remarks   String?
  createdAt DateTime @default(now())

  invoice FinInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([type])
  @@map("FinInvoiceDeduction")
}

model FinOutstanding {
  id                Int       @id @default(autoincrement())
  trackingNo        String?
  poNo              String?
  billNo            String?
  invoiceId         Int
  client            String?
  area              String?
  month             String?
  billDate          DateTime  @db.Date
  jobCode           String? // job wise costing
  costCenter        String? // cost center reference
  department        String? // department wise costing
  projectManager    String? // accountability
  invoiceValue      Float     @default(0)
  gstValue          Float     @default(0)
  totalInvoiceValue Float     @default(0)
  tdsDeduction      Float     @default(0)
  kpiDeduction      Float     @default(0)
  safetyDeduction   Float     @default(0)
  creditNote        Float     @default(0)
  otherDeduction    Float     @default(0)
  totalDeduction    Float     @default(0)
  afterTdsBalance   Float     @default(0)
  receivedAmount    Float     @default(0)
