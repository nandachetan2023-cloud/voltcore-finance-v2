generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceLog {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  logDate           DateTime
  punchIn           DateTime?
  punchOut          DateTime?
  status            String    @default("present")
  lateMinutes       Int       @default(0)
  fineAmount        Decimal   @default(0) @db.Decimal(10, 2)
  biometricDeviceId String?
  biometricLogId    String?
  source            String    @default("manual")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Employee          Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, logDate])
  @@index([logDate])
}

model BiometricRawLog {
  id          Int       @id @default(autoincrement())
  empCode     String
  enrolledId  String?
  name        String?
  punchDate   DateTime
  deviceId    String?
  mFlag       String?
  rawJson     Json
  processed   Boolean   @default(false)
  matched     Boolean   @default(false) // true = attendance record created/updated
  skipReason  String? // why it was processed without matching
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  siteId      String?

  @@index([empCode, punchDate])
  @@index([enrolledId])
  @@index([processed])
  @@index([siteId])
}

model BiometricSyncLog {
  id               Int      @id @default(autoincrement())
  lastRecord       String
  syncType         String   @default("incremental")
  recordsFetched   Int      @default(0)
  recordsProcessed Int      @default(0)
  status           String   @default("success")
  errorMessage     String?
  createdAt        DateTime @default(now())
  siteId           String?

  @@index([siteId])
}

model Branch {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  address        String?
  // Payroll divisors for this site (per attended day):
  //   monthlyWorkingDays — Fixed employees' earn-wages divisor.
  //   otType1Divisor / otType2Divisor — Non-fixed employees' earn-wages AND OT
  //     hourly-rate divisor, by their OT type. All default to 26.
  monthlyWorkingDays Int          @default(26)
  otType1Divisor     Int          @default(26)
  otType2Divisor     Int          @default(26)
  Employee       Employee[]
  Warehouse      Warehouse[]
  Holiday        Holiday[]
  AttendanceRule AttendanceRule[]
}

model Customer {
  id              Int               @id @default(autoincrement())
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Invoice         Invoice[]
  Quotation       Quotation[]
  SalesOrder      SalesOrder[]
  SalesTaxInvoice SalesTaxInvoice[]
}

model Department {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  code              String              @unique
  Employee          Employee[]
  AttendanceRule    AttendanceRule[]
  LeavePolicy       LeavePolicy[]
  ChecklistTemplate ChecklistTemplate[]
}

model Designation {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  Employee          Employee[]
  LeavePolicy       LeavePolicy[]
  ChecklistTemplate ChecklistTemplate[]
  SubDesignation SubDesignation[]
}

// A sub-designation is a child of a Designation (e.g. Fitter → Fitter Grade-1).
// Name is unique WITHIN its parent designation, not globally.
model SubDesignation {
  id            Int         @id @default(autoincrement())
  name          String
  designationId Int
  Designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  Employee      Employee[]
  LeavePolicy       LeavePolicy[]
  ChecklistTemplate ChecklistTemplate[]

  @@unique([designationId, name])
  @@index([designationId])
}

model Employee {
  id                        Int                         @id @default(autoincrement())
  employeeCode              String                      @unique
  tokenNumber               String?                     @unique
  workmenSlNo               String?
  monthlyGrossSalary        Decimal?                    @db.Decimal(15, 2)
  // Fixed daily rate of wages — the compliance "Register of Wages" column K
  // ("daily rate of wages/piece rate/monthly"). When set it is used verbatim in
  // payroll (compliance daily rate) instead of deriving basicSalary/workingDays.
  dailyWage                 Decimal?                    @db.Decimal(10, 2)
  natureOfDesignation       String?
  userId                    Int?                        @unique
  firstName                 String
  middleName                String?
  lastName                  String
  email                     String?                     @unique
  phone                     String?
  alternatePhone            String?
  dateOfBirth               DateTime?
  gender                    String?
  maritalStatus             String?
  bloodGroup                String?
  personalEmail             String?
  currentAddress            String?
  currentCity               String?
  currentState              String?
  currentPincode            String?
  permanentAddress          String?
  permanentCity             String?
  permanentState            String?
  permanentPincode          String?
  departmentId              Int
  designationId             Int
  subDesignationId          Int?
  branchId                  Int
  reportingManagerId        Int?
  dateOfJoining             DateTime
  confirmationDate          DateTime?
  // employmentType now classifies payroll behaviour: "fixed" | "non_fixed".
  // Fixed employees earn over the branch's monthly working days and get no OT;
  // non-fixed employees earn over 26 and get OT at the otType multiplier.
  employmentType            String?
  // OT multiplier class for NON-FIXED employees: 1 = 1x hourly OT, 2 = 2x hourly OT.
  // Ignored (no OT) when the employee is fixed. Mirrors the sheet's "OT Types".
  otType                    Int                         @default(1)
  employmentStatus          String
  probationMonths           Int                         @default(6)
  noticePeriodDays          Int                         @default(30)
  separationDate            DateTime?
  separationType            String?
  separationReason          String?
  panNumber                 String?
  aadharNumber              String?
  uanNumber                 String?
  esicNumber                String?
  bankName                  String?
  bankAccount               String?
  bankIfsc                  String?
  fatherName                String?
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?
  nomineeName               String?
  nomineeRelation           String?
  nomineeAddress            String?
  isActive                  Boolean                     @default(true)
  isDeleted                 Boolean                     @default(false)
  gradeId                   Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  AttendanceLog             AttendanceLog[]
  Branch                    Branch                      @relation(fields: [branchId], references: [id])
  Department                Department                  @relation(fields: [departmentId], references: [id])
  Designation               Designation                 @relation(fields: [designationId], references: [id])
  SubDesignation            SubDesignation?             @relation(fields: [subDesignationId], references: [id])
  Grade                     Grade?                      @relation(fields: [gradeId], references: [id])
  Employee                  Employee?                   @relation("EmployeeToEmployee", fields: [reportingManagerId], references: [id])
  other_Employee            Employee[]                  @relation("EmployeeToEmployee")
  User                      User?                       @relation(fields: [userId], references: [id])
  LeaveRequest              LeaveRequest[]
  TourRequest               TourRequest[]
  PayrollItem               PayrollItem[]
  SalaryStructureAssignment SalaryStructureAssignment[]
  ShiftAssignment           ShiftAssignment[]
  EmployeeRequest           EmployeeRequest[]
  OnboardingChecklist       OnboardingChecklist[]
  Resignation               Resignation[]

  @@index([isDeleted, employmentStatus])
  @@index([departmentId])
  @@index([branchId])
}

model Invoice {
  id           Int         @id @default(autoincrement())
  invoiceNo    String      @unique
  invoiceDate  DateTime
  customerId   Int
  salesOrderId Int?
  status       String      @default("draft")
  totalAmount  Decimal     @db.Decimal(15, 2)
  paidAmount   Decimal     @default(0) @db.Decimal(15, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  Customer     Customer    @relation(fields: [customerId], references: [id])
  SalesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
}

model Item {
  id                          Int              @id @default(autoincrement())
  sku                         String           @unique
  name                        String
  description                 String?
  categoryId                  Int?
  type                        String           @default("finished_goods")
  uomId                       Int
  purchaseUomId               Int?
  salesUomId                  Int?
  hsnSacCode                  String?
  costPrice                   Decimal          @default(0.00) @db.Decimal(15, 2)
  sellingPrice                Decimal          @default(0.00) @db.Decimal(15, 2)
  reorderLevel                Decimal          @default(0.00) @db.Decimal(15, 3)
  reorderQty                  Decimal          @default(0.00) @db.Decimal(15, 3)
  trackInventory              Boolean          @default(true)
  trackBatch                  Boolean          @default(false)
  trackSerial                 Boolean          @default(false)
  valuationMethod             String           @default("weighted_avg")
  imagePath                   String?
  isActive                    Boolean          @default(true)
  isDeleted                   Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime
  ItemCategory                ItemCategory?    @relation(fields: [categoryId], references: [id])
  Uom_Item_purchaseUomIdToUom Uom?             @relation("Item_purchaseUomIdToUom", fields: [purchaseUomId], references: [id])
  Uom_Item_salesUomIdToUom    Uom?             @relation("Item_salesUomIdToUom", fields: [salesUomId], references: [id])
  Uom_Item_uomIdToUom         Uom              @relation("Item_uomIdToUom", fields: [uomId], references: [id])
  QuotationItem               QuotationItem[]
  SalesOrderItem               SalesOrderItem[]
  StockEntryLine               StockEntryLine[]
  StockLedger                  StockLedger[]
  FinStoreGrnLine               FinStoreGrnLine[]
  FinMaterialRequisitionLine    FinMaterialRequisitionLine[]
  FinStoreIssueLine             FinStoreIssueLine[]
  FinMaterialReturnLine         FinMaterialReturnLine[]
  FinScrapEntry                 FinScrapEntry[]
  FinPhysicalVerificationLine   FinPhysicalVerificationLine[]
}

model ItemCategory {
  id   Int     @id @default(autoincrement())
  name String  @unique
  code String? @unique
  Item Item[]
}

model LeaveRequest {
  id                  Int       @id @default(autoincrement())
  employeeId          Int
  leaveType           String
  fromDate            DateTime
  toDate              DateTime
  days                Decimal   @default(1.0) @db.Decimal(5, 1)
  reason              String?
  supportingDocument  Json?
  status              String    @default("pending")
  currentStep         Int       @default(1)
  // When the request entered its CURRENT step. Reset on every step advance so
  // the 24h auto-approval window restarts for each approver. Null on rows that
  // predate the column; the sweep treats those as entering at appliedDate.
  stepEnteredAt       DateTime?
  // Steps that were passed by the 24h timer rather than by a person, as a
  // comma-separated list of step numbers ("1,3"). Kept so the audit trail can
  // distinguish an auto-approval from a real one.
  autoApprovedSteps   String    @default("")
  appliedDate         DateTime  @default(now())
  approvedBy          Int?
  approvedDate        DateTime?
  rejectedBy          Int?
  rejectedDate        DateTime?
  rejectionReason     String?
  // Which chain step rejected, and the approver role's name at that step.
  // Captured at rejection time because the chain can be edited afterwards —
  // resolving the role later could name whoever holds the step TODAY rather
  // than who actually rejected it.
  rejectedAtStep      Int?
  rejectedByRoleName  String?
  isDeleted           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime
  Employee            Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([fromDate, toDate])
}

model PayrollItem {
  id                   Int        @id @default(autoincrement())
  payrollRunId         Int
  employeeId           Int
  workingDays          Int        @default(26)
  presentDays          Int        @default(0)
  paidLeaveDays        Int        @default(0)
  lopDays              Int        @default(0)
  otHours              Decimal    @default(0) @db.Decimal(5, 2)
  basicSalary          Decimal    @default(0) @db.Decimal(15, 2)
  basicWagesPerDay     Decimal    @default(0) @db.Decimal(10, 2)
  hra                  Decimal    @default(0) @db.Decimal(15, 2)
  conveyanceAllowance  Decimal    @default(0) @db.Decimal(15, 2)
  medicalAllowance     Decimal    @default(0) @db.Decimal(15, 2)
  specialAllowance     Decimal    @default(0) @db.Decimal(15, 2)
  attendanceAllowance  Decimal    @default(0) @db.Decimal(15, 2)
  phAmount             Decimal    @default(0) @db.Decimal(15, 2)
  otAmount             Decimal    @default(0) @db.Decimal(15, 2)
  grossEarning         Decimal    @db.Decimal(15, 2)
  grossEarnWages       Decimal    @default(0) @db.Decimal(15, 2)
  totalNonComplianceAmount Decimal @default(0) @db.Decimal(15,2)
  pfDeduction          Decimal    @default(0) @db.Decimal(15, 2)
  esiDeduction         Decimal    @default(0) @db.Decimal(15, 2)
  ptDeduction          Decimal    @default(0) @db.Decimal(15, 2)
  tdsDeduction         Decimal    @default(0) @db.Decimal(15, 2)
  lopDeduction         Decimal    @default(0) @db.Decimal(15, 2)
  otherDeductions      Decimal    @default(0) @db.Decimal(15, 2)
  totalDeduction       Decimal    @db.Decimal(15, 2)
  netPay               Decimal    @db.Decimal(15, 2)
  status               String     @default("pending")
  payslipGenerated     Boolean    @default(false)
  payslipPath          String?
  remarks              String?
  details              Json?
  Employee             Employee   @relation(fields: [employeeId], references: [id])
  PayrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@index([employeeId, payrollRunId])
  @@index([payrollRunId])
}

model PayrollRun {
  id             Int           @id @default(autoincrement())
  name           String
  month          Int
  year           Int
  payrollType    String        @default("non-compliance") // "compliance" or "non-compliance"
  status         String        @default("draft")
  totalEmployees Int           @default(0)
  totalGross     Decimal       @default(0) @db.Decimal(15, 2)
  totalNet       Decimal       @default(0) @db.Decimal(15, 2)
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  PayrollItem    PayrollItem[]

  @@index([month, year, status])
  @@index([payrollType])
}

model PurchaseOrder {
  id          Int       @id @default(autoincrement())
  poNo        String    @unique
  poDate      DateTime
  warehouseId Int
  status      String    @default("draft")
  subtotal    Decimal   @db.Decimal(15, 2)
  taxAmount   Decimal   @db.Decimal(15, 2)
  totalAmount Decimal   @db.Decimal(15, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model Quotation {
  id            Int             @id @default(autoincrement())
  quotationNo   String          @unique
  quotationDate DateTime
  customerId    Int
  validUntil    DateTime?
  status        String          @default("draft")
  subtotal      Decimal         @db.Decimal(15, 2)
  taxAmount     Decimal         @db.Decimal(15, 2)
  totalAmount   Decimal         @db.Decimal(15, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Customer      Customer        @relation(fields: [customerId], references: [id])
  QuotationItem QuotationItem[]
  SalesOrder    SalesOrder[]
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  itemId      Int
  qty         Decimal   @db.Decimal(15, 3)
  rate        Decimal   @db.Decimal(15, 2)
  amount      Decimal   @db.Decimal(15, 2)
  Item        Item      @relation(fields: [itemId], references: [id])
  Quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model SalaryComponent {
  id                  Int                   @id @default(autoincrement())
  name                String
  code                String                @unique
  type                String                @default("earning")
  calculationType     String                @default("fixed")
  formula             String?
  defaultValue        Decimal               @default(0) @db.Decimal(15, 2)
  isTaxable           Boolean               @default(true)
  affectsGross        Boolean               @default(true)
  displayOrder        Int                   @default(0)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  SalaryStructureItem SalaryStructureItem[]
}

model SalaryStructure {
  id                        Int                         @id @default(autoincrement())
  name                      String                      @unique
  description               String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  SalaryStructureAssignment SalaryStructureAssignment[]
  SalaryStructureItem       SalaryStructureItem[]
}

model SalaryStructureAssignment {
  id                Int             @id @default(autoincrement())
  employeeId        Int
  salaryStructureId Int
  effectiveFrom     DateTime
  baseSalary        Decimal         @db.Decimal(15, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Employee          Employee        @relation(fields: [employeeId], references: [id])
  SalaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
}

model SalaryStructureItem {
  id                Int             @id @default(autoincrement())
  salaryStructureId Int
  componentId       Int
  fixedAmount       Decimal         @default(0) @db.Decimal(15, 2)
  formula           String?
  SalaryComponent   SalaryComponent @relation(fields: [componentId], references: [id])
  SalaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
}

model SalesOrder {
  id             Int              @id @default(autoincrement())
  soNo           String           @unique
  soDate         DateTime
  customerId     Int
  quotationId    Int?
  status         String           @default("draft")
  totalAmount    Decimal          @db.Decimal(15, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Invoice        Invoice[]
  Customer       Customer         @relation(fields: [customerId], references: [id])
  Quotation      Quotation?       @relation(fields: [quotationId], references: [id])
  SalesOrderItem SalesOrderItem[]
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  itemId       Int
  qty          Decimal    @db.Decimal(15, 3)
  rate         Decimal    @db.Decimal(15, 2)
  amount       Decimal    @db.Decimal(15, 2)
  Item         Item       @relation(fields: [itemId], references: [id])
  SalesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Shift {
  id              Int               @id @default(autoincrement())
  name            String
  type            String            @default("fixed")
  startTime       String
  endTime         String
  crossesMidnight Boolean           @default(false)
  breakMinutes    Int               @default(60)
  graceMinutes    Int               @default(15)
  otThresholdMin  Int               @default(30)
  // Hours-worked thresholds that decide attendance status for this shift:
  //   worked ≥ minPresentHours            → Present
  //   minHalfDayHours ≤ worked < minPresent → Half Day
  //   worked < minHalfDayHours            → Absent
  minPresentHours Float             @default(8)
  minHalfDayHours Float             @default(4)
  weekOffDays     Int[]
  isActive        Boolean           @default(true)
  isDeleted       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  ShiftAssignment ShiftAssignment[]
  AttendanceRule  AttendanceRule[]
}

model ShiftAssignment {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  shiftId       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Employee      Employee  @relation(fields: [employeeId], references: [id])
  Shift         Shift     @relation(fields: [shiftId], references: [id])

  @@index([employeeId, effectiveFrom])
}

model StockEntry {
  id                                              Int              @id @default(autoincrement())
  entryNo                                         String           @unique
  postingDate                                     DateTime
  type                                            String           @default("receipt")
  fromWarehouseId                                 Int?
  toWarehouseId                                   Int?
  referenceType                                   String?
  referenceNo                                     String?
  status                                          String           @default("draft")
  createdAt                                       DateTime         @default(now())
  updatedAt                                       DateTime
  Warehouse_StockEntry_fromWarehouseIdToWarehouse Warehouse?       @relation("StockEntry_fromWarehouseIdToWarehouse", fields: [fromWarehouseId], references: [id])
  Warehouse_StockEntry_toWarehouseIdToWarehouse   Warehouse?       @relation("StockEntry_toWarehouseIdToWarehouse", fields: [toWarehouseId], references: [id])
  StockEntryLine                                  StockEntryLine[]
  StockLedger                                     StockLedger[]
}

model StockEntryLine {
  id           Int        @id @default(autoincrement())
  stockEntryId Int
  itemId       Int
  qty          Decimal    @db.Decimal(15, 3)
  rate         Decimal    @db.Decimal(15, 2)
  Item         Item       @relation(fields: [itemId], references: [id])
  StockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
}

model StockLedger {
  id           Int        @id @default(autoincrement())
  itemId       Int
  warehouseId  Int
  stockEntryId Int
  qtyChange    Decimal    @db.Decimal(15, 3)
  balanceQty   Decimal    @db.Decimal(15, 3)
  postingDate  DateTime
  createdAt    DateTime   @default(now())
  Item         Item       @relation(fields: [itemId], references: [id])
  StockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
  Warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
}

model Uom {
  id                           Int    @id @default(autoincrement())
  name                         String @unique
  code                         String @unique
  Item_Item_purchaseUomIdToUom Item[] @relation("Item_purchaseUomIdToUom")
  Item_Item_salesUomIdToUom    Item[] @relation("Item_salesUomIdToUom")
  Item_Item_uomIdToUom         Item[] @relation("Item_uomIdToUom")
}

model User {
  id                 Int              @id @default(autoincrement())
  name               String
  email              String           @unique
  password           String
  phone              String?
  profilePhotoPath   String?
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  lastActiveAt       DateTime?
  preferences        Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Employee           Employee?
  WorkflowAction     WorkflowAction[]
}

model Warehouse {
  id                                               Int                 @id @default(autoincrement())
  name                                             String              @unique
  code                                             String              @unique
  branchId                                         Int
  type                                             String              @default("regular")
  address                                          String?
  createdAt                                        DateTime            @default(now())
  updatedAt                                        DateTime
  PurchaseOrder                                    PurchaseOrder[]
  StockEntry_StockEntry_fromWarehouseIdToWarehouse StockEntry[]        @relation("StockEntry_fromWarehouseIdToWarehouse")
  StockEntry_StockEntry_toWarehouseIdToWarehouse   StockEntry[]        @relation("StockEntry_toWarehouseIdToWarehouse")
  StockLedger                                      StockLedger[]
  Branch                                           Branch              @relation(fields: [branchId], references: [id])
  WarehouseLocation                                WarehouseLocation[]
}

model WarehouseLocation {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  name        String
  code        String
  Warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model WorkflowAction {
  id               Int              @id @default(autoincrement())
  instanceId       Int
  actionByUserId   Int
  action           String
  comment          String?
  createdAt        DateTime         @default(now())
  User             User             @relation(fields: [actionByUserId], references: [id])
  WorkflowInstance WorkflowInstance @relation(fields: [instanceId], references: [id])
}

model WorkflowDefinition {
  id               Int                @id @default(autoincrement())
  name             String
  entityType       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  WorkflowInstance WorkflowInstance[]
}

model WorkflowInstance {
  id                 Int                @id @default(autoincrement())
  definitionId       Int
  entityId           Int
  status             String             @default("pending")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  WorkflowAction     WorkflowAction[]
  WorkflowDefinition WorkflowDefinition @relation(fields: [definitionId], references: [id])
}

model JobOpening {
  id            Int      @id @default(autoincrement())
  position      String
  designationId Int?
  subDesignationId Int?
  site         String
  openings     Int
  applications Int      @default(0)
  priority     String
  status       String   @default("Open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Certification {
  id           Int      @id @default(autoincrement())
  empId        String
  employeeName String
  name         String
  issuedBy     String
  issueDate    String
  expiryDate   String
  status       String   @default("Valid")
  filePath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model TrainingSession {
  id        Int      @id @default(autoincrement())
  title     String
  site      String
  trainer   String
  date      String
  duration  String
  attendees Int      @default(0)
  status    String   @default("Scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Holiday {
  id           Int      @id @default(autoincrement())
  name         String
  date         DateTime
  type         String   @default("public")
  description  String?
  isRecurring  Boolean  @default(false)
  applicableTo String   @default("all")
  branchId     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Branch       Branch?  @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([branchId])
}

model LeavePolicy {
  id                    Int          @id @default(autoincrement())
  name                  String
  code                  String       @unique
  leaveType             String
  annualQuota           Decimal      @default(0) @db.Decimal(5, 1)
  carryForward          Boolean      @default(false)
  maxCarryForward       Decimal      @default(0) @db.Decimal(5, 1)
  encashable            Boolean      @default(false)
  maxEncashment         Decimal      @default(0) @db.Decimal(5, 1)
  minDaysNotice         Int          @default(0)
  maxConsecutiveDays    Int          @default(0)
  applicableAfterMonths Int          @default(0)
  applicableGender      String       @default("all")
  applicableTo          String       @default("all")
  departmentId          Int?
  designationId         Int?
  employeeId            Int?         // set when applicableTo == "employee" (scopes to one employee)
  requiresDocument      Boolean      @default(false)
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime
  // Earned Leave specific settings
  earnedLeaveAccrualMethod   String?  // "monthly" | "quarterly" | "annual"
  earnedLeaveAccrualRate     Decimal? @db.Decimal(5, 2) // days earned per accrual period
  earnedLeaveMaxAccumulation Decimal? @db.Decimal(5, 1) // max days that can accumulate
  earnedLeaveRoundingRule    String?  // "none" | "round_up" | "round_down" | "round_nearest"
  earnedLeaveEligibleAfterDays Int?   // days of service before EL starts accruing
  subDesignationId      Int?
  Department            Department?  @relation(fields: [departmentId], references: [id])
  Designation           Designation? @relation(fields: [designationId], references: [id])
  SubDesignation        SubDesignation? @relation(fields: [subDesignationId], references: [id])

  @@index([leaveType])
  @@index([departmentId])
  @@index([designationId])
  @@index([employeeId])
}

model AttendanceRule {
  id                   Int         @id @default(autoincrement())
  name                 String
  ruleType             String
  gracePeriodMinutes   Int         @default(0)
  lateMarkAfterMinutes Int         @default(0)
  halfDayAfterMinutes  Int         @default(0)
  absentAfterMinutes   Int         @default(0)
  fineAmount           Decimal     @default(0) @db.Decimal(10, 2)
  fineType             String      @default("fixed")
  finePerMinute        Decimal     @default(0) @db.Decimal(10, 2)
  maxFinePerDay        Decimal     @default(0) @db.Decimal(10, 2)
  applyToShiftId       Int?
  applyToDepartmentId  Int?
  applyToBranchId      Int?
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime
  Shift                Shift?      @relation(fields: [applyToShiftId], references: [id])
  Department           Department? @relation(fields: [applyToDepartmentId], references: [id])
  Branch               Branch?     @relation(fields: [applyToBranchId], references: [id])
}

model Grade {
  id          Int        @id @default(autoincrement())
  name        String
  code        String     @unique
  level       Int
  minSalary   Decimal    @default(0) @db.Decimal(15, 2)
  maxSalary   Decimal    @default(0) @db.Decimal(15, 2)
  description String?
  benefits    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  Employee    Employee[]

  @@index([level])
}

// Key-value store for company-wide settings (per tenant DB)
model CompanySettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

// Per-tenant biometric site configuration (stored in each tenant's DB)
model BiometricSiteConfig {
  id          Int      @id @default(autoincrement())
  siteId      String   @unique // e.g. "site1", "site2"
  siteName    String
  baseUrl     String   @default("https://api.etimeoffice.com/api")
  corporateId String
  username    String
  password    String // store encrypted in production
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

// ── Employee Requests (general + advance payment) ────────────────
model EmployeeRequest {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  requestType    String // "general" | "advance_payment"
  subject        String
  description    String
  amount         Decimal?  @db.Decimal(15, 2) // requested amount (advance_payment only)
  approvedAmount Decimal?  @db.Decimal(15, 2) // approver-adjusted amount (may differ from requested)
  status         String    @default("pending") // pending | approved | rejected
  currentStep    Int       @default(1) // which approval step we're waiting on
  approvedBy     Int?
  approvedDate   DateTime?
  rejectedBy     Int?
  rejectedDate   DateTime?
  rejectionNote  String?
  rejectedAtStep      Int?
  rejectedByRoleName  String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  Employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([requestType, status])
}

// ── In-app Notifications ─────────────────────────────────────────
model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int // TenantUser id (from superadmin DB) — stored as string ref
  userEmail  String // email of recipient (easier lookup)
  title      String
  message    String
  type       String   @default("info") // info | warning | success | error
  link       String   @default("") // optional deep link
  isRead     Boolean  @default(false)
  entityType String   @default("") // "leave" | "request" | "attendance"
  entityId   Int? // id of the related record
  createdAt  DateTime @default(now())

  @@index([userEmail, isRead])
  @@index([createdAt])
}

// ── Onboarding Checklist Templates (defined in Organization) ─────
model ChecklistTemplate {
  id            Int                     @id @default(autoincrement())
  name          String
  description   String?
  departmentId  Int?
  designationId Int?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime
  subDesignationId Int?
  Department    Department?              @relation(fields: [departmentId], references: [id])
  Designation   Designation?             @relation(fields: [designationId], references: [id])
  SubDesignation SubDesignation?         @relation(fields: [subDesignationId], references: [id])
  tasks         ChecklistTemplateTask[]
  instances     OnboardingChecklist[]

  @@index([departmentId])
  @@index([designationId])
}

model ChecklistTemplateTask {
  id                Int                     @id @default(autoincrement())
  templateId        Int
  title             String
  description       String?
  assignedRole      String                  @default("hr") // hr | it | manager | finance | admin
  dueDayOffset      Int                     @default(1) // days after joining
  dependsOnTaskId   Int? // dependency
  requiresDocument  Boolean                 @default(false)
  documentNecessary Boolean                 @default(false) // if true, task cannot be marked complete without a document upload
  order             Int                     @default(0)
  template          ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dependsOn         ChecklistTemplateTask?  @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependents        ChecklistTemplateTask[] @relation("TaskDependency")
  instanceTasks     OnboardingTask[]

  @@index([templateId])
}

// ── Onboarding Checklist Instances (per employee, in HRMS) ────────
model OnboardingChecklist {
  id          Int               @id @default(autoincrement())
  employeeId  Int
  templateId  Int
  status      String            @default("in_progress") // in_progress | completed | cancelled
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime
  Employee    Employee          @relation(fields: [employeeId], references: [id])
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  tasks       OnboardingTask[]

  @@index([employeeId])
}

model OnboardingTask {
  id               Int                   @id @default(autoincrement())
  checklistId      Int
  templateTaskId   Int
  status           String                @default("pending") // pending | in_progress | completed | skipped
  completedBy      Int?
  completedAt      DateTime?
  notes            String?
  documentPath     String? // filename for display
  documentData     Bytes? // file content stored in DB (Option 1)
  documentMimeType String? // e.g. "application/pdf", "image/jpeg"
  dueDate          DateTime?
  checklist        OnboardingChecklist   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  templateTask     ChecklistTemplateTask @relation(fields: [templateTaskId], references: [id])

  @@index([checklistId])
}

// ── Resignation & Offboarding ─────────────────────────────────────
model Resignation {
  id                Int             @id @default(autoincrement())
  employeeId        Int
  submittedAt       DateTime        @default(now())
  reason            String
  requestedLwd      DateTime // Last Working Day requested by employee
  calculatedLwd     DateTime? // System-calculated LWD
  noticePeriodDays  Int             @default(30)
  buyoutDays        Int             @default(0) // days bought out
  status            String          @default("pending") // pending | approved | rejected | withdrawn
  currentStep       Int             @default(1)
  managerApprovedAt DateTime?
  hrApprovedAt      DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Employee          Employee        @relation(fields: [employeeId], references: [id])
  exitInterview     ExitInterview?
  clearances        ExitClearance[]

  @@index([employeeId, status])
}

// ── Exit Interview & Clearance ────────────────────────────────────
model ExitInterview {
  id                 Int         @id @default(autoincrement())
  resignationId      Int         @unique
  conductedAt        DateTime?
  primaryReason      String? // compensation | growth | culture | personal | relocation | other
  cultureFeedback    String?
  managementFeedback String?
  suggestions        String?
  wouldRejoin        Boolean?
  rating             Int? // 1-5 overall company rating
  createdAt          DateTime    @default(now())
  updatedAt          DateTime
  resignation        Resignation @relation(fields: [resignationId], references: [id])
}

model ExitClearance {
  id            Int         @id @default(autoincrement())
  resignationId Int
  department    String // it | finance | admin | hr | manager
  status        String      @default("pending") // pending | cleared | flagged
  clearedBy     Int?
  clearedAt     DateTime?
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  resignation   Resignation @relation(fields: [resignationId], references: [id])

  @@index([resignationId])
}

// ── Notice Board ──────────────────────────────────────────────────
model Notice {
  id            Int       @id @default(autoincrement())
  title         String
  body          String
  type          String    @default("general") // general | policy | payroll | safety | hr | it
  targetDept    String? // null = all departments
  targetDesig   String? // null = all designations
  isPinned      Boolean   @default(false)
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?
  createdBy     Int?
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reads NoticeRead[]

  @@index([publishedAt])
  @@index([targetDept])
  @@index([targetDesig])
}

model NoticeRead {
  id         Int      @id @default(autoincrement())
  noticeId   Int
  employeeId Int
  readAt     DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, employeeId])
  @@index([employeeId])
}

// ── Tour Request: on-duty/tour approval (counts as paid attendance) ──
model TourRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  fromDate        DateTime
  toDate          DateTime
  days            Decimal   @default(1.0) @db.Decimal(5, 1)
  destination     String
  purpose         String
  remarks         String?
  status          String    @default("pending") // pending | approved | rejected
  currentStep     Int       @default(1)
  appliedDate     DateTime  @default(now())
  approvedBy      Int?
  approvedDate    DateTime?
  rejectedBy      Int?
  rejectedDate    DateTime?
  rejectionReason String?
  rejectedAtStep      Int?
  rejectedByRoleName  String?
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Employee        Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([fromDate, toDate])
}

// ── Finance & Accounting Models ──────────────────────────────────
model LedgerAccount {
  id            Int      @id @default(autoincrement())
  accountCode   String   @unique
  name          String
  group         String?
  type          String?
  parentAccount String?
  balance       Float    @default(0)
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountCode])
  @@index([group])
  @@map("LedgerAccount")
}

model JournalEntry {
  id             Int      @id @default(autoincrement())
  entryNo        String
  date           DateTime @db.Date
  account        String
  accountName    String?
  siteId         Int?
  partyId        Int?
  jobCode        String? // job wise costing
  poNo           String? // purchase order reference
  costCenter     String?
  department     String? // department wise costing
  projectManager String? // accountability
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String?
  reference      String?
  voucherType    String?
  status         String   @default("Posted")
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entryNo, account, debit, credit])
  @@index([entryNo])
  @@index([date])
  @@index([account])
  @@map("JournalEntry")
}

model AccountsPayable {
  id             Int       @id @default(autoincrement())
  billNo         String    @unique
  vendor         String
  vendorCode     String?
  invoiceRef     String?
  description    String?
  amount         Float
  tax            Float     @default(0)
  totalAmount    Float     @default(0)
  paidAmount     Float     @default(0) // cumulative across all payments — status must compare against this, not a single payment's amount
  dueDate        DateTime  @db.Date
  paidDate       DateTime? @db.Date
  paymentMethod  String?
  paymentRef     String?
  status         String    @default("Pending")
  remarks        String?
  siteId         Int? // site wise costing
  partyId        Int? // linked vendor master (FinParty), backfilled by name match
  poId           Int? // linked purchase order
  jobCode        String? // job wise costing
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site  FinSite?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  party FinParty?         @relation(fields: [partyId], references: [id], onDelete: SetNull)
  po    FinPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  @@index([billNo])
  @@index([vendor])
  @@index([status])
  @@index([dueDate])
  @@index([siteId])
  @@index([partyId])
  @@index([poId])
  @@map("AccountsPayable")
}

model AccountsReceivable {
  id             Int       @id @default(autoincrement())
  invoiceNo      String    @unique
  client         String
  clientCode     String?
  invoiceRef     String?
  description    String?
  amount         Float
  tax            Float     @default(0)
  totalAmount    Float     @default(0)
  dueDate        DateTime  @db.Date
  receivedAmount Float     @default(0) // payments collected so far
  tdsAmount      Float     @default(0) // TDS deducted by client
  deductionType  String? // other deduction option (Retention | Liquidated Damages | Advance Recovery | Discount | Freight | Other)
  otherDeduction Float     @default(0) // other deduction amount
  receivedDate   DateTime? @db.Date
  paymentMethod  String?
  paymentRef     String?
  status         String    @default("Pending")
  remarks        String?
  siteId         Int? // site wise costing
  partyId        Int? // linked customer master (FinParty), backfilled by name match
  jobCode        String? // job wise costing
  poNo           String? // purchase order reference
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site  FinSite?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  party FinParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([invoiceNo])
  @@index([client])
  @@index([status])
  @@index([dueDate])
  @@index([siteId])
  @@index([partyId])
  @@map("AccountsReceivable")
}

model BankAccount {
  id          Int      @id @default(autoincrement())
  accountName String
  bankName    String
  branch      String?
  accountNo   String   @unique
  ifsc        String?
  type        String   @default("Current")
  balance     Float    @default(0)
  currency    String   @default("INR")
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions      BankTransaction[]
  finPayments       FinPayment[]
  finPaymentAdvices FinPaymentAdvice[]

  @@index([accountNo])
  @@map("BankAccount")
}

model BankTransaction {
  id              Int      @id @default(autoincrement())
  bankAccountId   Int
  date            DateTime @db.Date
  type            String?
  transactionType String? // Payment | Receipt | Contra | Transfer | Charges | Interest
  amount          Float
  balance         Float    @default(0)
  reference       String?
  party           String?
  description     String?
  category        String?
  siteCode        String? // site wise costing
  jobCode         String? // job wise costing
  poNo            String? // purchase order reference
  costCenter      String? // cost center reference
  department      String? // department wise costing
  projectManager  String? // accountability
  status          String   @default("Completed")
  reconciled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
  @@index([date])
  @@index([type])
  @@index([transactionType])
  @@map("BankTransaction")
}

model TaxRecord {
  id             Int       @id @default(autoincrement())
  taxType        String
  period         String
  amount         Float
  dueDate        DateTime  @db.Date
  paidDate       DateTime? @db.Date
  paymentRef     String?
  status         String    @default("Pending")
  remarks        String?
  siteCode       String? // site wise costing
  jobCode        String? // job wise costing
  poNo           String? // purchase order reference
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([taxType, period])
  @@index([taxType])
  @@index([period])
  @@map("TaxRecord")
}

model BudgetItem {
  id             Int      @id @default(autoincrement())
  category       String
  description    String
  planned        Float
  actual         Float    @default(0)
  variance       Float    @default(0)
  period         String
  month          String?
  siteId         Int? // site wise budget vs actual
  jobCode        String? // job wise costing
  poNo           String? // purchase order reference
  costCenter     String? // cost center reference
  department     String? // department wise costing
  projectManager String? // accountability
  status         String   @default("On Track")
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site FinSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([period])
  @@index([siteId])
  @@map("BudgetItem")
}

// ── Finance – Site & AR Management ──────────────────────────────────
model FinSite {
  id                Int       @id @default(autoincrement())
  siteCode          String    @unique
  name              String
  location          String?
  state             String?
  projectType       String?
  billingEntity     String?
  responsiblePerson String?
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  budget            Float     @default(0)
  pettyCashLimit    Float?    @default(0) // sanctioned petty cash float for this site's custodian (responsiblePerson)
  customerId        Int? // the customer this site/project belongs to
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  status            String    @default("Active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer            FinParty?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  jobs                FinJob[]
  invoices            FinInvoice[]
  areas               FinArea[]
  expenseClaims       FinExpenseClaim[]
  purchaseOrders      FinPurchaseOrder[]
  paymentAdvices      FinPaymentAdvice[]
  creditNotes         FinCreditNote[]
  outstanding         FinOutstanding[]
  alerts              FinAlert[]
  finJournalEntries   FinJournalEntry[]
  finBudgets          FinBudget[]
  finAssets           FinAsset[]
  finPettyCashes      FinPettyCash[]
budgetItems        BudgetItem[]
  accountsPayables   AccountsPayable[]
  accountsReceivables AccountsReceivable[]
  storeGrns             FinStoreGrn[]
  materialRequisitions  FinMaterialRequisition[]
  storeIssues           FinStoreIssue[]
  materialReturns       FinMaterialReturn[]
  tools                 FinTool[]
  gatePasses            FinGatePass[]
  equipment             FinEquipment[]
  scrapEntries          FinScrapEntry[]
  physicalVerifications FinPhysicalVerification[]

  @@index([siteCode])
  @@map("FinSite")
}

// ── RBAC: finance approval roles, permissions, site-scoped assignments ──
// level: 1=Requester … 5=Director. Higher level = more authority.
// readOnly roles (Auditor) carry VIEW/EXPORT only.
model FinRole {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. CUSTODIAN, FIN_HEAD, AUDITOR
  name      String // e.g. Finance Head
  description String? // free-text role description (role-management screen)
  level     Int      @default(1) // 1..5 hierarchy
  readOnly  Boolean  @default(false) // Auditor-type: view/export only
  color     String   @default("#00d4ff") // UI badge color
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions FinRolePermission[]
  assignments FinUserRole[]

  @@map("FinRole")
}

// One permission code per (module, action), e.g. PETTYCASH_APPROVE
model FinPermission {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique // e.g. PETTYCASH_APPROVE
  module             String // GL | AP | AR | PettyCash | Purchase | Payroll | Inventory | Reports
  action             String // CREATE | VIEW | EDIT | APPROVE | DELETE | EXPORT
  description        String?
  finRolePermissions FinRolePermission[]

  @@unique([module, code])
  @@map("FinPermission")
}

// Many-to-many: which permissions each role carries
model FinRolePermission {
  id           Int           @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         FinRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   FinPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([roleId, permissionId])
  @@map("FinRolePermission")
}

// Site-scoped assignment: (userEmail, role, siteCode). siteCode null = all sites.
// One user may hold the same role across several sites; authority never crosses
// to sites the user is not assigned to. SoD conflicts are enforced at write-time
// via FinSodRule (see /api/fin/rbac/assignments).
model FinUserRole {
  id        Int      @id @default(autoincrement())
  userEmail String
  userName  String?
  roleId    Int
  role      FinRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  siteCode  String? // null = all sites
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userEmail, roleId, siteCode])
  @@index([userEmail])
  @@index([siteCode])
  @@map("FinUserRole")
}

// Segregation-of-Duties: pairs of roles that cannot both be held by one person
// (e.g. Custodian × Finance Head — prevents self-approval of petty cash).
// Enforced when assigning users and when checking permissions.
model FinSodRule {
  id          Int      @id @default(autoincrement())
  roleACode   String // e.g. CUSTODIAN
  roleBCode   String // e.g. FINANC_MGR (must not be held simultaneously)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([roleACode, roleBCode])
  @@map("FinSodRule")
}

// Compliance audit trail — every permission check (success and denial),
// with actor, module, action, decision and request IP.
model FinAccessAuditLog {
  id             Int      @id @default(autoincrement())
  userEmail      String
  module         String
  permissionCode String?
  action         String
  entityId       String? // e.g. voucher id / site the action targeted
  siteCode       String?
  ip             String?
  success        Boolean
  deniedReason   String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userEmail])
  @@index([module])
  @@map("FinAccessAuditLog")
}

// ── Finance Master: Party (Client/Vendor) ─────────────────────────────────────
model FinParty {
  id           Int      @id @default(autoincrement())
  code         String?  @unique
  name         String   @unique
  shortName    String?
  partyType    String   @default("Other") // Customer | Vendor | Employee | Advance Holder | Other
  gstin        String?
  pan          String?
  address      String?
  state        String?
  stateCode    String?
  contact      String?
  udyam        String?
  tdsSection   String?
  tdsRate      Float    @default(0)
  gstTreatment String   @default("Unregistered") // Unregistered | Registered | Composition
  taxType      String   @default("Auto") // Auto | Intra-State (CGST+SGST) | Inter-State (IGST) | Exempt/SEZ
  paymentTerms String? // e.g. "Net 30", "Net 45", "Advance"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites               FinSite[]
  invoices            FinInvoice[]
  paymentAdvices      FinPaymentAdvice[]
  tdsDeductions       FinTdsDeduction[]
  finPettyCashes      FinPettyCash[]
  accountsPayables    AccountsPayable[]
  accountsReceivables AccountsReceivable[]

  @@index([name])
  @@map("FinParty")
}

// ── Finance Master: Area (under a Site) ──────────────────────────────────────
model FinArea {
  id        Int      @id @default(autoincrement())
  siteId    Int
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     FinSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  invoices FinInvoice[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("FinArea")
}

model FinInvoice {
  id              Int       @id @default(autoincrement())
  invoiceNo       String
  trackingNo      String?
  poNo            String?
  siteId          Int
  areaId          Int?
  poId            Int?
  partyId         Int?
  client          String? // legacy/free-text (kept for compatibility)
  area            String? // legacy/free-text (kept for compatibility)
  month           String?
  financialYear   String? // e.g. "2025-26" (for uniqueness and reporting)
  invoiceDate     DateTime  @db.Date
  eInvoiceDate    DateTime? @db.Date
  dueDate         DateTime  @db.Date
  jobCode         String? // job wise costing
  costCenter      String? // cost center reference
  department      String? // department wise costing
  projectManager  String? // accountability
  hsnSac          String?
  taxableValue    Float     @default(0)
  workPercent     Float     @default(0) // RA % work complete
  cgstAmount      Float     @default(0)
  sgstAmount      Float     @default(0)
  igstAmount      Float     @default(0)
  cessAmount      Float     @default(0)
  invoiceValue    Float     @default(0)
  gstValue        Float     @default(0)
  grandTotal      Float     @default(0)
  tdsDeduction    Float     @default(0)
  retentionAmount Float     @default(0)
  kpiDeduction    Float     @default(0)
  safetyDeduction Float     @default(0)
  otherDeduction  Float     @default(0)
  totalDeduction  Float     @default(0)
  afterTdsBalance Float     @default(0)
  amountPaid      Float     @default(0)
  receivedAmount  Float     @default(0)
  receivedAmount2 Float     @default(0)
  receivedDate    DateTime? @db.Date
  voucherNo       String?
  roundoffAmount  Float     @default(0)
  balanceAmount   Float     @default(0)
  description     String?
  remarks         String?
  status          String    @default("Unpaid")
  postedBy        String?
  approvedBy      String?
  postedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  party              FinParty?              @relation(fields: [partyId], references: [id])
  site               FinSite                @relation(fields: [siteId], references: [id])
  areaRef            FinArea?               @relation(fields: [areaId], references: [id])
  po                 FinPurchaseOrder?      @relation(fields: [poId], references: [id])
  payments           FinPayment[]
  deductions         FinInvoiceDeduction[]
  tdsDeductions      FinTdsDeduction[]
  followUps          FinFollowUp[]
  creditNotes        FinCreditNote[]
  alerts             FinAlert[]
  outstanding        FinOutstanding[]
  paymentAdviceLines FinPaymentAdviceLine[]

  @@unique([partyId, invoiceNo, financialYear])
  @@index([invoiceNo])
  @@index([partyId, financialYear])
  @@index([siteId])
  @@index([status])
  @@index([dueDate])
  @@map("FinInvoice")
}

// ── Finance: Deductions (normalized; many per invoice) ───────────────────────
model FinInvoiceDeduction {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  type      String // TDS | KPI | SAFETY | RETENTION | OTHER | ROUND_OFF | CREDIT_NOTE
  amount    Float    @default(0)
