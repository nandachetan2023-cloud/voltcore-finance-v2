generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceLog {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  logDate           DateTime
  punchIn           DateTime?
  punchOut          DateTime?
  status            String    @default("present")
  biometricDeviceId String?
  biometricLogId    String?
  source            String    @default("manual")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Employee          Employee  @relation(fields: [employeeId], references: [id])
}

model BiometricRawLog {
  id          Int       @id @default(autoincrement())
  empCode     String
  name        String?
  punchDate   DateTime
  deviceId    String?
  mFlag       String?
  rawJson     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  siteId      String?

  @@index([empCode, punchDate])
  @@index([processed])
  @@index([siteId])
}

model BiometricSyncLog {
  id               Int      @id @default(autoincrement())
  lastRecord       String
  syncType         String   @default("incremental")
  recordsFetched   Int      @default(0)
  recordsProcessed Int      @default(0)
  status           String   @default("success")
  errorMessage     String?
  createdAt        DateTime @default(now())
  siteId           String?

  @@index([siteId])
}

model Branch {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  address   String?
  Employee  Employee[]
  Warehouse Warehouse[]
}

model Customer {
  id            Int          @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  Invoice       Invoice[]
  Quotation     Quotation[]
  SalesOrder    SalesOrder[]
}

model Department {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  code     String     @unique
  Employee Employee[]
}

model Designation {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  Employee Employee[]
}

model Employee {
  id                        Int                         @id @default(autoincrement())
  employeeCode              String                      @unique
  userId                    Int?                        @unique
  firstName                 String
  middleName                String?
  lastName                  String
  email                     String                      @unique
  phone                     String
  alternatePhone            String?
  dateOfBirth               DateTime
  gender                    String
  maritalStatus             String?
  bloodGroup                String?
  personalEmail             String?
  currentAddress            String
  currentCity               String
  currentState              String
  currentPincode            String
  permanentAddress          String?
  permanentCity             String?
  permanentState            String?
  permanentPincode          String?
  departmentId              Int
  designationId             Int
  branchId                  Int
  reportingManagerId        Int?
  dateOfJoining             DateTime
  confirmationDate          DateTime?
  employmentType            String
  employmentStatus          String
  probationMonths           Int                         @default(6)
  noticePeriodDays          Int                         @default(30)
  separationDate            DateTime?
  separationType            String?
  separationReason          String?
  panNumber                 String?
  aadharNumber              String?
  uanNumber                 String?
  esicNumber                String?
  emergencyContactName      String?
  emergencyContactRelation  String?
  emergencyContactPhone     String?
  isActive                  Boolean                     @default(true)
  isDeleted                 Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  AttendanceLog             AttendanceLog[]
  Branch                    Branch                      @relation(fields: [branchId], references: [id])
  Department                Department                  @relation(fields: [departmentId], references: [id])
  Designation               Designation                 @relation(fields: [designationId], references: [id])
  Employee                  Employee?                   @relation("EmployeeToEmployee", fields: [reportingManagerId], references: [id])
  other_Employee            Employee[]                  @relation("EmployeeToEmployee")
  User                      User?                       @relation(fields: [userId], references: [id])
  LeaveRequest              LeaveRequest[]
  PayrollItem               PayrollItem[]
  SalaryStructureAssignment SalaryStructureAssignment[]
  ShiftAssignment           ShiftAssignment[]
}

model Invoice {
  id           Int           @id @default(autoincrement())
  invoiceNo    String        @unique
  invoiceDate  DateTime
  customerId   Int
  salesOrderId Int?
  status       String        @default("draft")
  totalAmount  Decimal       @db.Decimal(15, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(15, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Customer     Customer      @relation(fields: [customerId], references: [id])
  SalesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  InvoiceItem  InvoiceItem[]
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  itemId    Int
  qty       Decimal @db.Decimal(15, 3)
  rate      Decimal @db.Decimal(15, 2)
  amount    Decimal @db.Decimal(15, 2)
  Invoice   Invoice @relation(fields: [invoiceId], references: [id])
  Item      Item    @relation(fields: [itemId], references: [id])
}

model Item {
  id                          Int                 @id @default(autoincrement())
  sku                         String              @unique
  name                        String
  description                 String?
  categoryId                  Int?
  type                        String              @default("finished_goods")
  uomId                       Int
  purchaseUomId               Int?
  salesUomId                  Int?
  hsnSacCode                  String?
  costPrice                   Decimal             @default(0.00) @db.Decimal(15, 2)
  sellingPrice                Decimal             @default(0.00) @db.Decimal(15, 2)
  reorderLevel                Decimal             @default(0.00) @db.Decimal(15, 3)
  reorderQty                  Decimal             @default(0.00) @db.Decimal(15, 3)
  trackInventory              Boolean             @default(true)
  trackBatch                  Boolean             @default(false)
  trackSerial                 Boolean             @default(false)
  valuationMethod             String              @default("weighted_avg")
  imagePath                   String?
  isActive                    Boolean             @default(true)
  isDeleted                   Boolean             @default(false)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime
  InvoiceItem                 InvoiceItem[]
  ItemCategory                ItemCategory?       @relation(fields: [categoryId], references: [id])
  Uom_Item_purchaseUomIdToUom Uom?                @relation("Item_purchaseUomIdToUom", fields: [purchaseUomId], references: [id])
  Uom_Item_salesUomIdToUom    Uom?                @relation("Item_salesUomIdToUom", fields: [salesUomId], references: [id])
  Uom_Item_uomIdToUom         Uom                 @relation("Item_uomIdToUom", fields: [uomId], references: [id])
  PurchaseOrderItem           PurchaseOrderItem[]
  QuotationItem               QuotationItem[]
  SalesOrderItem              SalesOrderItem[]
  StockEntryLine              StockEntryLine[]
  StockLedger                 StockLedger[]
}

model ItemCategory {
  id   Int     @id @default(autoincrement())
  name String  @unique
  code String? @unique
  Item Item[]
}

model Lead {
  id            Int            @id @default(autoincrement())
  leadNo        String         @unique
  companyName   String
  contactPerson String
  email         String?
  phone         String?
  status        String         @default("new")
  source        String?
  assignedToId  Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  LeadActivity  LeadActivity[]
}

model LeadActivity {
  id           Int      @id @default(autoincrement())
  leadId       Int
  type         String   @default("note")
  subject      String
  description  String?
  activityDate DateTime
  createdAt    DateTime @default(now())
  Lead         Lead     @relation(fields: [leadId], references: [id])
}

model LeaveRequest {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  leaveType       String
  fromDate        DateTime
  toDate          DateTime
  days            Decimal   @default(1.0) @db.Decimal(5, 1)
  reason          String?
  status          String    @default("pending")
  appliedDate     DateTime  @default(now())
  approvedBy      Int?
  approvedDate    DateTime?
  rejectedBy      Int?
  rejectedDate    DateTime?
  rejectionReason String?
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Employee        Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([fromDate, toDate])
}

model PayrollItem {
  id             Int        @id @default(autoincrement())
  payrollRunId   Int
  employeeId     Int
  grossEarning   Decimal    @db.Decimal(15, 2)
  totalDeduction Decimal    @db.Decimal(15, 2)
  netPay         Decimal    @db.Decimal(15, 2)
  details        Json
  Employee       Employee   @relation(fields: [employeeId], references: [id])
  PayrollRun     PayrollRun @relation(fields: [payrollRunId], references: [id])
}

model PayrollRun {
  id          Int           @id @default(autoincrement())
  name        String
  month       Int
  year        Int
  status      String        @default("draft")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  PayrollItem PayrollItem[]
}

model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  poNo              String              @unique
  poDate            DateTime
  vendorId          Int
  warehouseId       Int
  status            String              @default("draft")
  subtotal          Decimal             @db.Decimal(15, 2)
  taxAmount         Decimal             @db.Decimal(15, 2)
  totalAmount       Decimal             @db.Decimal(15, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  Vendor            Vendor              @relation(fields: [vendorId], references: [id])
  Warehouse         Warehouse           @relation(fields: [warehouseId], references: [id])
  PurchaseOrderItem PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  itemId          Int
  qty             Decimal       @db.Decimal(15, 3)
  rate            Decimal       @db.Decimal(15, 2)
  amount          Decimal       @db.Decimal(15, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(15, 3)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Item            Item          @relation(fields: [itemId], references: [id])
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model Quotation {
  id            Int             @id @default(autoincrement())
  quotationNo   String          @unique
  quotationDate DateTime
  customerId    Int
  validUntil    DateTime?
  status        String          @default("draft")
  subtotal      Decimal         @db.Decimal(15, 2)
  taxAmount     Decimal         @db.Decimal(15, 2)
  totalAmount   Decimal         @db.Decimal(15, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Customer      Customer        @relation(fields: [customerId], references: [id])
  QuotationItem QuotationItem[]
  SalesOrder    SalesOrder[]
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  itemId      Int
  qty         Decimal   @db.Decimal(15, 3)
  rate        Decimal   @db.Decimal(15, 2)
  amount      Decimal   @db.Decimal(15, 2)
  Item        Item      @relation(fields: [itemId], references: [id])
  Quotation   Quotation @relation(fields: [quotationId], references: [id])
}

model SalaryComponent {
  id                  Int                   @id @default(autoincrement())
  name                String
  code                String                @unique
  type                String                @default("earning")
  calculationType     String                @default("fixed")
  formula             String?
  defaultValue        Decimal               @default(0) @db.Decimal(15, 2)
  isTaxable           Boolean               @default(true)
  affectsGross        Boolean               @default(true)
  displayOrder        Int                   @default(0)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  SalaryStructureItem SalaryStructureItem[]
}

model SalaryStructure {
  id                        Int                         @id @default(autoincrement())
  name                      String                      @unique
  description               String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  SalaryStructureAssignment SalaryStructureAssignment[]
  SalaryStructureItem       SalaryStructureItem[]
}

model SalaryStructureAssignment {
  id                Int             @id @default(autoincrement())
  employeeId        Int
  salaryStructureId Int
  effectiveFrom     DateTime
  baseSalary        Decimal         @db.Decimal(15, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Employee          Employee        @relation(fields: [employeeId], references: [id])
  SalaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
}

model SalaryStructureItem {
  id                Int             @id @default(autoincrement())
  salaryStructureId Int
  componentId       Int
  fixedAmount       Decimal         @default(0) @db.Decimal(15, 2)
  formula           String?
  SalaryComponent   SalaryComponent @relation(fields: [componentId], references: [id])
  SalaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id])
}

model SalesOrder {
  id             Int              @id @default(autoincrement())
  soNo           String           @unique
  soDate         DateTime
  customerId     Int
  quotationId    Int?
  status         String           @default("draft")
  totalAmount    Decimal          @db.Decimal(15, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Invoice        Invoice[]
  Customer       Customer         @relation(fields: [customerId], references: [id])
  Quotation      Quotation?       @relation(fields: [quotationId], references: [id])
  SalesOrderItem SalesOrderItem[]
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  itemId       Int
  qty          Decimal    @db.Decimal(15, 3)
  rate         Decimal    @db.Decimal(15, 2)
  amount       Decimal    @db.Decimal(15, 2)
  Item         Item       @relation(fields: [itemId], references: [id])
  SalesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

model Shift {
  id              Int               @id @default(autoincrement())
  name            String
  type            String            @default("fixed")
  startTime       String
  endTime         String
  crossesMidnight Boolean           @default(false)
  breakMinutes    Int               @default(60)
  graceMinutes    Int               @default(15)
  otThresholdMin  Int               @default(30)
  weekOffDays     Int[]
  isActive        Boolean           @default(true)
  isDeleted       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  ShiftAssignment ShiftAssignment[]
}

model ShiftAssignment {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  shiftId       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Employee      Employee  @relation(fields: [employeeId], references: [id])
  Shift         Shift     @relation(fields: [shiftId], references: [id])
}

model StockEntry {
  id                                              Int              @id @default(autoincrement())
  entryNo                                         String           @unique
  postingDate                                     DateTime
  type                                            String           @default("receipt")
  fromWarehouseId                                 Int?
  toWarehouseId                                   Int?
  referenceType                                   String?
  referenceNo                                     String?
  status                                          String           @default("draft")
  createdAt                                       DateTime         @default(now())
  updatedAt                                       DateTime
  Warehouse_StockEntry_fromWarehouseIdToWarehouse Warehouse?       @relation("StockEntry_fromWarehouseIdToWarehouse", fields: [fromWarehouseId], references: [id])
  Warehouse_StockEntry_toWarehouseIdToWarehouse   Warehouse?       @relation("StockEntry_toWarehouseIdToWarehouse", fields: [toWarehouseId], references: [id])
  StockEntryLine                                  StockEntryLine[]
  StockLedger                                     StockLedger[]
}

model StockEntryLine {
  id           Int        @id @default(autoincrement())
  stockEntryId Int
  itemId       Int
  qty          Decimal    @db.Decimal(15, 3)
  rate         Decimal    @db.Decimal(15, 2)
  Item         Item       @relation(fields: [itemId], references: [id])
  StockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
}

model StockLedger {
  id           Int        @id @default(autoincrement())
  itemId       Int
  warehouseId  Int
  stockEntryId Int
  qtyChange    Decimal    @db.Decimal(15, 3)
  balanceQty   Decimal    @db.Decimal(15, 3)
  postingDate  DateTime
  createdAt    DateTime   @default(now())
  Item         Item       @relation(fields: [itemId], references: [id])
  StockEntry   StockEntry @relation(fields: [stockEntryId], references: [id])
  Warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
}

model Uom {
  id                           Int    @id @default(autoincrement())
  name                         String @unique
  code                         String @unique
  Item_Item_purchaseUomIdToUom Item[] @relation("Item_purchaseUomIdToUom")
  Item_Item_salesUomIdToUom    Item[] @relation("Item_salesUomIdToUom")
  Item_Item_uomIdToUom         Item[] @relation("Item_uomIdToUom")
}

model User {
  id                 Int              @id @default(autoincrement())
  name               String
  email              String           @unique
  password           String
  phone              String?
  profilePhotoPath   String?
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  lastActiveAt       DateTime?
  preferences        Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  Employee           Employee?
  WorkflowAction     WorkflowAction[]
}

model Vendor {
  id            Int             @id @default(autoincrement())
  vendorCode    String          @unique
  vendorName    String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  PurchaseOrder PurchaseOrder[]
}

model Warehouse {
  id                                               Int                 @id @default(autoincrement())
  name                                             String              @unique
  code                                             String              @unique
  branchId                                         Int
  type                                             String              @default("regular")
  address                                          String?
  createdAt                                        DateTime            @default(now())
  updatedAt                                        DateTime
  PurchaseOrder                                    PurchaseOrder[]
  StockEntry_StockEntry_fromWarehouseIdToWarehouse StockEntry[]        @relation("StockEntry_fromWarehouseIdToWarehouse")
  StockEntry_StockEntry_toWarehouseIdToWarehouse   StockEntry[]        @relation("StockEntry_toWarehouseIdToWarehouse")
  StockLedger                                      StockLedger[]
  Branch                                           Branch              @relation(fields: [branchId], references: [id])
  WarehouseLocation                                WarehouseLocation[]
}

model WarehouseLocation {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  name        String
  code        String
  Warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model WorkflowAction {
  id               Int              @id @default(autoincrement())
  instanceId       Int
  actionByUserId   Int
  action           String
  comment          String?
  createdAt        DateTime         @default(now())
  User             User             @relation(fields: [actionByUserId], references: [id])
  WorkflowInstance WorkflowInstance @relation(fields: [instanceId], references: [id])
}

model WorkflowDefinition {
  id               Int                @id @default(autoincrement())
  name             String
  entityType       String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  WorkflowInstance WorkflowInstance[]
}

model WorkflowInstance {
  id                 Int                @id @default(autoincrement())
  definitionId       Int
  entityId           Int
  status             String             @default("pending")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  WorkflowAction     WorkflowAction[]
  WorkflowDefinition WorkflowDefinition @relation(fields: [definitionId], references: [id])
}

model JobOpening {
  id           Int      @id @default(autoincrement())
  position     String
  designationId Int?
  site         String
  openings     Int
  applications Int      @default(0)
  priority     String
  status       String   @default("Open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Certification {
  id           Int      @id @default(autoincrement())
  empId        String
  employeeName String
  name         String
  issuedBy     String
  issueDate    String
  expiryDate   String
  status       String   @default("Valid")
  filePath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model TrainingSession {
  id        Int      @id @default(autoincrement())
  title     String
  site      String
  trainer   String
  date      String
  duration  String
  attendees Int      @default(0)
  status    String   @default("Scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime
}
