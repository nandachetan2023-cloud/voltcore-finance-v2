  totalRows   Int       @default(0)
  createdRows Int       @default(0)
  updatedRows Int       @default(0)
  skippedRows Int       @default(0)
  errorRows   Int       @default(0)
  status      String    @default("Pending") // Pending | Processing | Completed | Failed
  rawJson     String? // JSON snapshot of parsed records (for audit)
  log         String? // error log / messages
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())

  // CA-grade extensions
  direction   String    @default("Import") // Import | Export
  companyName String?
  finYear     String? // e.g. "2025-26"
  voucherType String? // Sales | Purchase | Payment | Receipt | Journal | Contra | Credit Note
  trigger     String? // manual | scheduled | onApprove
  hash        String? // SHA256 of canonical XML
  alterID     String? // Tally AlterID
  actorEmail  String?
  actorIp     String?
  durationMs  Int       @default(0)
  attemptCount Int      @default(0)
  nextRetryAt DateTime?
  reconciled  Boolean   @default(false)
  reconciledAt DateTime?

  @@index([syncType])
  @@index([status])
  @@index([syncedAt])
  @@index([companyName, finYear])
  @@index([direction])
  @@map("FinTallySync")
}

// ── Tally Voucher Link (ERP ↔ Tally AlterID, idempotency) ──────────
model FinTallyVoucher {
  id           Int       @id @default(autoincrement())
  finYear      String // "2025-26"
  voucherNo    String
  voucherType  String // Sales | Purchase | Payment | Receipt | Journal | Contra | Credit Note
  companyName  String
  erpRefType   String // FinInvoice | FinJournalEntry | AccountsPayable | FinPayment | FinCreditNote
  erpRefId     Int
  tallyAlterID String?
  tallyMasterID String?
  hash         String // SHA256 canonical XML
  status       String    @default("Pending") // Pending | Sent | Acked | Failed | Voided
  jsonPayload  Json?
  responseXml  String?   @db.Text
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyName, finYear, voucherType, voucherNo])
  @@index([erpRefType, erpRefId])
  @@index([companyName, finYear])
  @@index([status])
  @@map("FinTallyVoucher")
}

// ── Voucher Series (gapless FY sequential) ─────────────────────────
model FinVoucherSeries {
  id      Int    @id @default(autoincrement())
  finYear String // "2025-26"
  type    String // Sales | Purchase | Payment | Receipt | Journal | Contra | Credit Note
  lastNo  Int    @default(0)

  @@unique([finYear, type])
  @@map("FinVoucherSeries")
}

// ── Ultra Notifications (Finance Purchase & Sales) ─────────────────
model FinNotification {
  id           Int       @id @default(autoincrement())
  userEmail    String
  actorEmail   String?
  entityType   String // FinInvoice|FinPurchaseOrder|AccountsPayable|FinTallyVoucher|FinJournalEntry|FinPR|FinStoreGrn
  entityId     String
  title        String
  message      String    @db.Text
  type         String    @default("info") // info|warning|error|success
  priority     String    @default("P2") // P0|P1|P2
  channel      String    @default("inapp") // inapp|email|whatsapp|sms|push
  siteCode     String?
  jobCode      String?
  finYear      String? // 2025-26
  amount       Float?
  currency     String?   @default("INR")
  link         String?
  status       String    @default("unread") // unread|read|actioned|snoozed|escalated|archived
  isRead       Boolean   @default(false)
  readAt       DateTime?
  snoozedUntil DateTime?
  escalatedAt  DateTime?
  escalatedTo  String?
  hash         String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userEmail, status])
  @@index([finYear, siteCode])
  @@index([hash])
  @@index([priority])
  @@map("FinNotification")
}

model FinNotificationPreference {
  userEmail  String   @id
  channels   Json     @default("{\"inapp\":true,\"email\":true}")
  digest     String   @default("realtime") // realtime|hourly|daily|off
  quietHours Json?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("FinNotificationPreference")
}

model FinNotificationTemplate {
  code       String @id // AP_OVERDUE_45D | TALLY_FAILED | GRN_SHORT
  titleTpl   String
  messageTpl String
  priority   String @default("P2")
  channel    String @default("inapp")
  createdAt  DateTime @default(now())

  @@map("FinNotificationTemplate")
}

// ── Data Sync Configuration ─────────────────────────────────────
// Per-module sync configuration (used by /api/sync/route.ts)
model SyncConfig {
  module       String    @id
  enabled      Boolean   @default(true)
  autoSync     Boolean   @default(false)
  syncInterval Int       @default(300) // seconds between auto-syncs
  lastSyncAt   DateTime?
  lastStatus   String    @default("Never") // Never | Syncing | Success | Completed with Errors | Failed
  totalSynced  Int       @default(0)
  totalErrors  Int       @default(0)
  endpoint     String?
  authKey      String?
  nextSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("SyncConfig")
}

// ── Data Sync Log ────────────────────────────────────────────────
// Individual sync operation log entries
model SyncLog {
  id             Int       @id @default(autoincrement())
  module         String
  action         String // CREATE | UPDATE | DELETE | SYNC | RESOLVE
  recordId       String?
  recordData     String? // JSON snapshot
  status         String    @default("Pending") // Pending | Success | Conflict | Error | Resolved
  direction      String    @default("Pull") // Pull | Push | Bidirectional
  conflictReason String?
  syncBatchId    String?
  duration       Int       @default(0) // ms
  recordsSynced  Int       @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  resolved       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([module])
  @@index([status])
  @@index([syncBatchId])
  @@index([createdAt])
  @@map("SyncLog")
}

// ── Client Follow Up ────────────────────────────────────────────
model FinClientFollowUp {
  id              Int       @id @default(autoincrement())
  clientName      String
  balanceAmount   Float     @default(0)
  poId            Int?
  invoiceNos      String? // comma-separated invoice references
  contactNo       String?
  contactPerson   String?
  matterDiscussed String?
  callBackDate    DateTime? @db.Date
  remarks         String?
  status          String    @default("Pending") // Pending | In Progress | Resolved | Closed
  followUpDate    DateTime? @db.Date
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  po FinPurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)

  @@index([clientName])
  @@index([status])
  @@index([callBackDate])
  @@index([poId])
  @@map("FinClientFollowUp")
}

// ── Inventory – Stock Ledger running balance ─────────────────────
// Posting direction: +qtyChange = receipt/in, -qtyChange = issue/out.
model FinStockLedger {
  id            Int      @id @default(autoincrement())
  entryNo       String
  postingDate   DateTime @db.Date
  itemCode      String
  itemName      String
  category      String?
  unit          String   @default("Nos")
  warehouse     String?
  warehouseId   Int?
  qtyIn         Float    @default(0)
  qtyOut        Float    @default(0)
  balanceQty    Float    @default(0) // running balance after this line
  rate          Float    @default(0)
  valueIn       Float    @default(0)
  valueOut      Float    @default(0)
  referenceType String   @default("") // Stock Receipt | Material Issue | Stock Transfer | Adjustment
  referenceNo   String?
  jobCode       String?
  siteCode      String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemCode])
  @@index([postingDate])
  @@index([jobCode])
  @@index([itemCode, warehouseId])
  @@map("FinStockLedger")
}

// ── Inventory – Material Issue → Job (WIP posting) ────────────────
// Issued material debits a job's work-in-progress account.
model FinMaterialIssue {
  id         Int      @id @default(autoincrement())
  issueNo    String   @unique
  issueDate  DateTime @db.Date
  siteCode   String?
  siteId     Int?
  jobCode    String
  jobName    String @default("")
  itemCode   String?
  itemName   String @default("")
  warehouseId Int?
  description String
  qty        Float    @default(0)
  unit       String   @default("Nos")
  rate       Float    @default(0)
  amount     Float    @default(0)
  wipAccount String? // coa code to credit/debit WIP
  status     String   @default("Posted") // Draft | Posted | Reversed
  remarks    String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([jobCode])
  @@index([issueDate])
  @@index([status])
  @@map("FinMaterialIssue")
}

// ── Sales – Running Account (RA) work-progress ────────────────────
// Bills a % completion of a purchase order / job over time.
model FinMootBill {
  id            Int      @id @default(autoincrement())
  raNo          String   @unique
  raDate        DateTime @db.Date
  siteCode      String?
  siteId        Int?
  jobCode       String
  jobName       String  @default("")
  poNo          String?
  poId          Int?
  poTotal       Float    @default(0)
  workPercent   Float    @default(0) // % work complete
  billAmount    Float    @default(0) // bill = workPercent% of PO total (computed)
  previousWork  Float    @default(0) // already billed %
  billedSoFar   Float    @default(0) // amount already billed from prev RAs
  deducted      Float    @default(0)
  withholding   Float    @default(0)
  netRavFor     Float    @default(0)
  invoiceNo     String?
  status        String   @default("Draft") // Draft | Submitted | Approved | Invoiced
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([poId])
  @@index([jobCode])
  @@index([status])
  @@map("FinMootBill")
}

// ── Projects – Bill of Quantities (BOQ) ───────────────
// A BOQ belongs to a site (and optional job/PO) and carries line items with
// quantity, rate and amount so budget-vs-actual can be tracked per item.
model FinBoq {
  id         Int         @id @default(autoincrement())
  boqNo      String      @unique
  title      String
  siteId     Int?
  siteCode   String?
  jobCode    String?
  jobName    String   @default("")
  poNo       String?
  project    String?
  version    String   @default("V1")
  status     String   @default("Draft") // Draft | Approved | Closed
  totalQty   Float    @default(0)
  totalAmount Float   @default(0)
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lines      FinBoqItem[]

  @@index([siteId])
  @@index([jobCode])
  @@map("FinBoq")
}

model FinBoqItem {
  id            Int      @id @default(autoincrement())
  boqId         Int
  itemNo        String   @default("")
  description   String
  uom           String   @default("Nos")
  qty           Float    @default(0)
  rate          Float    @default(0)
  amount        Float    @default(0)
  executedQty   Float    @default(0) // actual qty executed (progress)
  executedValue Float    @default(0)
  remarks       String?
  sortOrder     Int      @default(0)

  boq           FinBoq   @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@index([boqId])
  @@map("FinBoqItem")
}

// ── Projects – Job Progress & Milestones ──────────────
// Tracks %-completion and milestone checklist per job/site.
model FinProjectProgress {
  id          Int      @id @default(autoincrement())
  jobCode     String
  jobName     String   @default("")
  siteCode    String?
  siteId      Int?
  overallPct  Float    @default(0) // overall % complete (0-100)
  status      String   @default("In Progress") // Not Started | In Progress | On Hold | Completed
  milestone   String?  // current milestone name
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones  FinMilestone[]

  @@index([jobCode])
  @@map("FinProjectProgress")
}

model FinMilestone {
  id          Int      @id @default(autoincrement())
  progressId  Int
  name        String
  pct         Float    @default(0) // weight of this milestone
  achievedPct Float    @default(0) // how much of this milestone done (0-100)
  done        Boolean  @default(false)
  dueDate     DateTime? @db.Date
  notes       String?

  progress    FinProjectProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@map("FinMilestone")
}

// ════════════════════════════════════════════════════════════════════
// Site Store Management — GRN, MRS-gated issue, returns, tool/gate-pass/
// equipment registers, scrap and physical verification. Every header
// carries real FKs to FinSite/FinJob so it rolls up into the same
// site/job costing Finance already reports on; every line carries a
// real FK to Item — the same catalog Sales (QuotationItem/SalesOrderItem)
// already uses — instead of the free-text itemCode/jobCode string tags
// the older FinMaterialReceipt/FinMaterialIssue/FinStockLedger models use.
// ════════════════════════════════════════════════════════════════════

model FinStoreGrn {
  id          Int       @id @default(autoincrement())
  grnNo       String    @unique
  grnDate     DateTime  @db.Date
  poId        Int?
  siteId      Int
  jobId       Int?
  vendorName  String?
  dcNo        String? // delivery challan no
  invoiceNo   String?
  status      String    @default("Draft") // Draft | Posted | Rejected
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  po    FinPurchaseOrder?  @relation(fields: [poId], references: [id], onDelete: SetNull)
  site  FinSite            @relation(fields: [siteId], references: [id])
  job   FinJob?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lines FinStoreGrnLine[]

  @@index([siteId])
  @@index([jobId])
  @@index([poId])
  @@map("FinStoreGrn")
}

model FinStoreGrnLine {
  id           Int      @id @default(autoincrement())
  grnId        Int
  itemId       Int
  poItemId     Int?
  qtyOrdered   Float    @default(0)
  qtyReceived  Float    @default(0)
  qtyAccepted  Float    @default(0)
  qtyRejected  Float    @default(0)
  rate         Float    @default(0)
  amount       Float    @default(0)
  condition    String   @default("Good") // Good | Damaged | Partial
  remarks      String?

  grn     FinStoreGrn @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item    Item        @relation(fields: [itemId], references: [id])
  poItem  FinPOItem?  @relation(fields: [poItemId], references: [id], onDelete: SetNull)

  @@index([grnId])
  @@index([itemId])
  @@map("FinStoreGrnLine")
}

model FinMaterialRequisition {
  id           Int      @id @default(autoincrement())
  mrsNo        String   @unique
  mrsDate      DateTime @db.Date
  siteId       Int
  jobId        Int?
  requestedBy  String?
  department   String?
  purpose      String?
  status       String   @default("Draft") // Draft | Pending | Approved | Rejected | Issued
  approvedBy   String?
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site   FinSite                     @relation(fields: [siteId], references: [id])
  job    FinJob?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lines  FinMaterialRequisitionLine[]
  issues FinStoreIssue[]

  @@index([siteId])
  @@index([jobId])
  @@index([status])
  @@map("FinMaterialRequisition")
}

model FinMaterialRequisitionLine {
  id            Int    @id @default(autoincrement())
  mrsId         Int
  itemId        Int
  qtyRequested  Float  @default(0)
  qtyIssued     Float  @default(0)
  remarks       String?

  mrs  FinMaterialRequisition @relation(fields: [mrsId], references: [id], onDelete: Cascade)
  item Item                   @relation(fields: [itemId], references: [id])

  @@index([mrsId])
  @@index([itemId])
  @@map("FinMaterialRequisitionLine")
}

model FinStoreIssue {
  id          Int       @id @default(autoincrement())
  issueNo     String    @unique
  issueDate   DateTime  @db.Date
  mrsId       Int?
  siteId      Int
  jobId       Int?
  issuedTo    String?
  receiverSignature String?
  issuedBy    String?
  status      String    @default("Issued") // Issued | Reversed
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mrs   FinMaterialRequisition? @relation(fields: [mrsId], references: [id], onDelete: SetNull)
  site  FinSite                 @relation(fields: [siteId], references: [id])
  job   FinJob?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lines FinStoreIssueLine[]

  @@index([siteId])
  @@index([jobId])
  @@index([mrsId])
  @@map("FinStoreIssue")
}

model FinStoreIssueLine {
  id      Int    @id @default(autoincrement())
  issueId Int
  itemId  Int
  qty     Float  @default(0)
  rate    Float  @default(0)
  amount  Float  @default(0)

  issue FinStoreIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item  Item          @relation(fields: [itemId], references: [id])

  @@index([issueId])
  @@index([itemId])
  @@map("FinStoreIssueLine")
}

model FinMaterialReturn {
  id          Int      @id @default(autoincrement())
  returnNo    String   @unique
  returnDate  DateTime @db.Date
  siteId      Int
  jobId       Int?
  returnedBy  String?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site  FinSite                @relation(fields: [siteId], references: [id])
  job   FinJob?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lines FinMaterialReturnLine[]

  @@index([siteId])
  @@index([jobId])
  @@map("FinMaterialReturn")
}

model FinMaterialReturnLine {
  id        Int    @id @default(autoincrement())
  returnId  Int
  itemId    Int
  qty       Float  @default(0)
  condition String @default("Good") // Good | Damaged
  remarks   String?

  return FinMaterialReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item   Item              @relation(fields: [itemId], references: [id])

  @@index([returnId])
  @@index([itemId])
  @@map("FinMaterialReturnLine")
}

model FinTool {
  id         Int      @id @default(autoincrement())
  toolCode   String   @unique
  name       String
  category   String? // Grinding Machine | Welding Machine | Chain Pulley Block | Sling | Measuring Tool | Other
  siteId     Int
  status     String   @default("Available") // Available | Issued | Under Repair | Lost
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site FinSite          @relation(fields: [siteId], references: [id])
  logs FinToolIssueLog[]

  @@index([siteId])
  @@map("FinTool")
}

model FinToolIssueLog {
  id                 Int       @id @default(autoincrement())
  toolId             Int
  issuedTo           String
  issueDate          DateTime  @db.Date
  expectedReturnDate DateTime? @db.Date
  returnDate         DateTime? @db.Date
  condition          String? // Good | Damaged | Lost
  remarks            String?

  tool FinTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
  @@map("FinToolIssueLog")
}

model FinGatePass {
  id             Int      @id @default(autoincrement())
  gatePassNo     String   @unique
  gatePassDate   DateTime @db.Date
  type           String   @default("Outward") // Outward | Inward | Returnable | Non-Returnable
  siteId         Int
  itemDescription String
  qty            Float    @default(0)
  vehicleNo      String?
  driverName     String?
  purpose        String?
  authorizedBy   String?
  status         String   @default("Open") // Open | Closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site FinSite @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@map("FinGatePass")
}

model FinEquipment {
  id            Int      @id @default(autoincrement())
  equipmentCode String   @unique
  name          String
  type          String? // Crane | Vehicle | Other
  siteId        Int
  status        String   @default("Active") // Active | Under Maintenance | Idle
  operatorName  String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site FinSite            @relation(fields: [siteId], references: [id])
  logs FinEquipmentLog[]

  @@index([siteId])
  @@map("FinEquipment")
}

model FinEquipmentLog {
  id            Int      @id @default(autoincrement())
  equipmentId   Int
  logDate       DateTime @db.Date
  hoursUsed     Float?
  kmReading     Float?
  fuelConsumed  Float?
  remarks       String?

  equipment FinEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("FinEquipmentLog")
}

model FinScrapEntry {
  id             Int      @id @default(autoincrement())
  scrapNo        String   @unique
  scrapDate      DateTime @db.Date
  siteId         Int
  jobId          Int?
  itemId         Int?
  description    String
  qty            Float    @default(0)
  unit           String   @default("Nos")
  estimatedValue Float    @default(0)
  disposalStatus String   @default("Pending") // Pending | Disposed | Sold
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site FinSite @relation(fields: [siteId], references: [id])
  job  FinJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  item Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([jobId])
  @@map("FinScrapEntry")
}

model FinPhysicalVerification {
  id             Int      @id @default(autoincrement())
  verificationNo String   @unique
  verificationDate DateTime @db.Date
  siteId         Int
  type           String   @default("Monthly") // Daily | Weekly | Monthly
  verifiedBy     String?
  status         String   @default("Draft") // Draft | Completed
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site  FinSite                       @relation(fields: [siteId], references: [id])
  lines FinPhysicalVerificationLine[]

  @@index([siteId])
  @@map("FinPhysicalVerification")
}

model FinPhysicalVerificationLine {
  id            Int    @id @default(autoincrement())
  verificationId Int
  itemId        Int
  bookQty       Float  @default(0)
  physicalQty   Float  @default(0)
  variance      Float  @default(0)
  remarks       String?

  verification FinPhysicalVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  item         Item                    @relation(fields: [itemId], references: [id])

  @@index([verificationId])
  @@index([itemId])
  @@map("FinPhysicalVerificationLine")
}
