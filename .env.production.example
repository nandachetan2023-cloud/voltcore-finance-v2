# ============================================================
# VoltCore ERP — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to version control.
# ============================================================

# ── Databases ───────────────────────────────────────────────
# Superadmin DB: stores tenants, users, roles, biometric configs
SUPERADMIN_DATABASE_URL="postgresql://erp_user:yourpassword@localhost:5432/erp_superadmin?schema=public"

# Main tenant DB (used for Prisma migrations and default tenant)
DATABASE_URL="postgresql://erp_user:yourpassword@localhost:5432/erp?schema=public"

# Demo tenant DB (optional — for demo/testing accounts)
DEMO_DATABASE_URL="postgresql://erp_user:yourpassword@localhost:5432/erp_demo?schema=public"

# ── Email / SMTP ─────────────────────────────────────────────
# Used for OTP password reset emails.
# Gmail: go to myaccount.google.com/apppasswords to generate an App Password.
# (Requires 2-Step Verification to be enabled on your Google account)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="VoltCore ERP <your-email@gmail.com>"

# ── Node Environment ─────────────────────────────────────────
NODE_ENV="production"
