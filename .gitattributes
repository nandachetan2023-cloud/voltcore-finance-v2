# Normalize text files in the repository to LF.
* text=auto eol=lf

# Shell scripts must stay LF: CRLF breaks them on Linux/CI.
*.sh text eol=lf
*.bash text eol=lf

# SQL and config consumed by tooling (Prisma, migrations, CI).
*.sql text eol=lf
*.prisma text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diff or EOL-convert.
*.db binary
*.sqlite binary
*.pdf binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary